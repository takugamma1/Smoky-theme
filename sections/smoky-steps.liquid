{% comment %}
  Smoky steps — clean cream stage: huge title with the pink numbered star
  badge biting its corner, ONE centered step text at a time (crossfade +
  lift between steps), round arrows at the section edges, dot pagination
  and shevitsa ornament underneath, mascot in the corner.
{% endcomment %}

{%- assign badge_points = '100.0,0.0 109.2,18.5 122.3,2.5 127.1,22.6 143.4,9.9 143.6,30.6 162.3,21.8 158.0,42.0 178.2,37.7 169.4,56.4 190.1,56.6 177.4,72.9 197.5,77.7 181.5,90.8 200.0,100.0 181.5,109.2 197.5,122.3 177.4,127.1 190.1,143.4 169.4,143.6 178.2,162.3 158.0,158.0 162.3,178.2 143.6,169.4 143.4,190.1 127.1,177.4 122.3,197.5 109.2,181.5 100.0,200.0 90.8,181.5 77.7,197.5 72.9,177.4 56.6,190.1 56.4,169.4 37.7,178.2 42.0,158.0 21.8,162.3 30.6,143.6 9.9,143.4 22.6,127.1 2.5,122.3 18.5,109.2 0.0,100.0 18.5,90.8 2.5,77.7 22.6,72.9 9.9,56.6 30.6,56.4 21.8,37.7 42.0,42.0 37.7,21.8 56.4,30.6 56.6,9.9 72.9,22.6 77.7,2.5 90.8,18.5' -%}

<section class="smoky-steps smoky-grained{% if section.settings.curve_top %} smoky-curl-top{% endif %}{% if section.settings.curve_bottom %} smoky-curl-bottom{% endif %}" id="smoky-steps-{{ section.id }}">
  <button type="button" class="smoky-arrow smoky-arrow--prev smoky-steps__edge smoky-steps__edge--left" data-dir="-1" aria-label="Назад">
    <span class="smoky-arrow__shadow"></span>
    <span class="smoky-arrow__fill">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </button>
  <button type="button" class="smoky-arrow smoky-steps__edge smoky-steps__edge--right" data-dir="1" aria-label="Напред">
    <span class="smoky-arrow__shadow"></span>
    <span class="smoky-arrow__fill">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </button>

  <div class="smoky-container smoky-steps__inner">
    <div class="smoky-steps__head" data-smoky-reveal>
      <h2 class="smoky-title smoky-steps__title">{{ section.settings.heading }}</h2>
      <span class="smoky-steps__badge">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <polygon points="{{ badge_points }}" fill="var(--smoky-pink)"></polygon>
        </svg>
        <span class="smoky-steps__number">1.</span>
      </span>
    </div>

    <div class="smoky-steps__viewport" data-smoky-drag-cursor tabindex="0">
      <ul class="smoky-steps__track">
        {%- for block in section.blocks -%}
          <li class="smoky-steps__slide{% if forloop.first %} is-active{% endif %}" data-step="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.text }}</h3>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="smoky-steps__dots" role="tablist" aria-label="Стъпки">
      {%- for block in section.blocks -%}
        <button type="button" class="smoky-steps__dot{% if forloop.first %} is-active{% endif %}" data-goto="{{ forloop.index0 }}" aria-label="Стъпка {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>

    <div class="smoky-shevitsa-row smoky-steps__ornament" aria-hidden="true">
      <span class="smoky-shevitsa"></span><span class="smoky-shevitsa"></span><span class="smoky-shevitsa"></span>
    </div>

    <span class="smoky-steps__mascot" data-smoky-scrub-rotate="18" aria-hidden="true">
      <img src="{{ 'smoky-mascot-surprised.svg' | asset_url }}" alt="" loading="lazy" width="120" height="120">
    </span>
  </div>
</section>

<style>
  #smoky-steps-{{ section.id }} {
    position: relative;
    background: var(--smoky-cream);
    color: var(--smoky-dark);
    padding-block: clamp(72px, 10vw, 150px);
    overflow: clip;
  }


  #smoky-steps-{{ section.id }} .smoky-steps__inner { position: relative; }

  #smoky-steps-{{ section.id }} .smoky-steps__head {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  #smoky-steps-{{ section.id }} .smoky-steps__title {
    text-align: center;
    font-size: clamp(3.4rem, 9vw, 10rem);
    line-height: 0.9;
  }

  /* numbered star badge biting into the title's top-right corner */
  #smoky-steps-{{ section.id }} .smoky-steps__badge {
    position: relative;
    width: clamp(60px, 7vw, 116px);
    height: clamp(60px, 7vw, 116px);
    flex: 0 0 auto;
    margin-top: calc(clamp(60px, 7vw, 116px) * -0.34);
    margin-left: calc(clamp(60px, 7vw, 116px) * -0.38);
    z-index: 1;
  }

  #smoky-steps-{{ section.id }} .smoky-steps__badge svg {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.6s var(--smoky-bounce);
  }

  #smoky-steps-{{ section.id }} .smoky-steps__badge.is-spun svg { transform: rotate(32deg); }

  #smoky-steps-{{ section.id }} .smoky-steps__number {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--smoky-cream);
    font-family: var(--smoky-font-heading);
    font-weight: 800;
    font-size: clamp(1.4rem, 2.1vw, 2.3rem);
  }

  #smoky-steps-{{ section.id }} .smoky-steps__viewport {
    margin-top: clamp(28px, 4vw, 56px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }

  #smoky-steps-{{ section.id }} .smoky-steps__viewport::-webkit-scrollbar { display: none; }

  #smoky-steps-{{ section.id }} .smoky-steps__track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* one step visible at a time: neighbours fade out, active lifts in */
  #smoky-steps-{{ section.id }} .smoky-steps__slide {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: center;
    padding-inline: clamp(16px, 3vw, 48px);
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.45s var(--smoky-ease), transform 0.5s var(--smoky-bounce);
  }

  #smoky-steps-{{ section.id }} .smoky-steps__slide.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  #smoky-steps-{{ section.id }} .smoky-steps__slide h3 {
    margin: 0 auto;
    max-width: 34ch;
    font-family: var(--smoky-font-body);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.4vw, 2.25rem);
    line-height: 1.4;
    color: var(--smoky-dark);
  }

  /* arrows pinned to the section edges, at title height */
  #smoky-steps-{{ section.id }} .smoky-steps__edge {
    position: absolute;
    top: 42%;
    z-index: 2;
  }

  #smoky-steps-{{ section.id }} .smoky-steps__edge--left { left: clamp(10px, 3.5vw, 56px); }
  #smoky-steps-{{ section.id }} .smoky-steps__edge--right { right: clamp(10px, 3.5vw, 56px); }

  /* dot pagination */
  #smoky-steps-{{ section.id }} .smoky-steps__dots {
    display: flex;
    justify-content: center;
    gap: clamp(10px, 1.2vw, 16px);
    margin-top: clamp(26px, 3.4vw, 44px);
  }

  #smoky-steps-{{ section.id }} .smoky-steps__dot {
    width: 13px;
    height: 13px;
    padding: 0;
    border: 2px solid var(--smoky-dark);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.3s var(--smoky-bounce);
  }

  #smoky-steps-{{ section.id }} .smoky-steps__dot:hover { transform: scale(1.25); }
  #smoky-steps-{{ section.id }} .smoky-steps__dot.is-active { background: var(--smoky-dark); }

  #smoky-steps-{{ section.id }} .smoky-steps__ornament {
    margin-top: clamp(18px, 2.2vw, 28px);
    color: var(--smoky-dark);
    font-size: clamp(0.7rem, 0.85vw, 0.9rem);
    opacity: 0.85;
  }

  #smoky-steps-{{ section.id }} .smoky-steps__mascot {
    position: absolute;
    right: clamp(-10px, 1vw, 40px);
    bottom: clamp(-16px, -1vw, 0px);
    width: clamp(84px, 9vw, 140px);
    filter: drop-shadow(0 8px 12px rgb(40 40 40 / 0.3));
    z-index: 2;
  }

  #smoky-steps-{{ section.id }} .smoky-steps__mascot img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    #smoky-steps-{{ section.id }} .smoky-steps__edge { top: auto; bottom: clamp(56px, 12vw, 84px); }
    #smoky-steps-{{ section.id }} .smoky-steps__edge--left { left: 18px; }
    #smoky-steps-{{ section.id }} .smoky-steps__edge--right { right: 18px; }
    #smoky-steps-{{ section.id }} .smoky-steps__mascot { display: none; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('smoky-steps-{{ section.id }}');
    if (!root) return;
    const viewport = root.querySelector('.smoky-steps__viewport');
    const slides = [...root.querySelectorAll('.smoky-steps__slide')];
    const dots = [...root.querySelectorAll('.smoky-steps__dot')];
    const badge = root.querySelector('.smoky-steps__badge');
    const number = root.querySelector('.smoky-steps__number');
    if (!viewport || !slides.length) return;

    root.querySelectorAll('.smoky-arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        viewport.scrollBy({ left: slides[0].offsetWidth * parseInt(btn.dataset.dir, 10), behavior: 'smooth' });
      });
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = slides[parseInt(dot.dataset.goto, 10)];
        if (target) viewport.scrollTo({ left: target.offsetLeft - (viewport.clientWidth - target.offsetWidth) / 2, behavior: 'smooth' });
      });
    });

    let current = '1';
    const sync = () => {
      const mid = viewport.scrollLeft + viewport.clientWidth / 2;
      const active = slides.find((s) => s.offsetLeft <= mid && mid < s.offsetLeft + s.offsetWidth) || slides[0];
      slides.forEach((s) => s.classList.toggle('is-active', s === active));
      dots.forEach((d, i) => d.classList.toggle('is-active', String(i + 1) === active.dataset.step));
      if (active.dataset.step !== current) {
        current = active.dataset.step;
        number.textContent = current + '.';
        badge.classList.toggle('is-spun');
      }
    };
    viewport.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Smoky стъпки",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие",
      "default": "СТЪПКА"
    },
    {
      "type": "checkbox",
      "id": "curve_top",
      "label": "Заоблен горен ръб (над тъмно)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "curve_bottom",
      "label": "Заоблен долен ръб (над тъмно)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Стъпка",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Текст",
          "default": "Разгледай менюто и си избери любимата скара."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Smoky стъпки",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "text": "Разгледай менюто и избери любимата си скара — кебапчета, кюфтета, стекове или сач."
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Поръчай онлайн за минути — без обаждания, без чакане на линия."
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Мятаме месото на жарта в мига, в който поръчката ти пристигне при нас."
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Опаковаме всичко горещо в брандирана опаковка, която пази вкуса и димеца."
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Нашата доставка тръгва веднага — средно 30 минути до твоята врата."
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Добър апетит! Остава само да си доволен — и гладен за още."
          }
        }
      ]
    }
  ]
}
{% endschema %}
