{% comment %}
  Smoky funnel — the FTC "Trek gekregen?" conversion beat, split into the
  two ways to get Smoky: order online (delivery) or come eat on site.
  Big title + copy, then two path cards: pink "Поръчай онлайн" with the
  mascot, dark "Ела на място" with address / hours / map link. Optional
  third mini-link row (phone) underneath.
{%- endcomment %}

<section class="smoky-funnel smoky-grained{% if section.settings.curve_top %} smoky-curl-top{% endif %}{% if section.settings.curve_bottom %} smoky-curl-bottom{% endif %}" id="smoky-funnel-{{ section.id }}">
  <div class="smoky-container smoky-container--medium">
    <div class="smoky-funnel__head" data-smoky-reveal>
      <h2 class="smoky-title smoky-title--main">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="smoky-funnel__lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="smoky-funnel__paths">
      <a href="{% render 'smoky-url', link: section.settings.order_link, kind: 'menu' %}" class="smoky-funnel__card smoky-funnel__card--order" data-smoky-reveal>
        <svg class="smoky-dotted-frame" aria-hidden="true" preserveAspectRatio="none">
          <rect style="x:1px;y:1px;width:calc(100% - 2px);height:calc(100% - 2px)" rx="24" stroke="var(--smoky-cream)"></rect>
        </svg>
        <span class="smoky-funnel__mascot" aria-hidden="true">
          <img src="{{ 'smoky-mascot-happy.svg' | asset_url }}" alt="" loading="lazy" width="140" height="140">
        </span>
        <span class="smoky-kicker smoky-funnel__kicker">{{ section.settings.order_kicker }}</span>
        <span class="smoky-funnel__title">{{ section.settings.order_title }}</span>
        <span class="smoky-funnel__text">{{ section.settings.order_text }}</span>
        <span class="smoky-btn smoky-btn--dark smoky-funnel__btn">
          <span class="smoky-btn__shadow"></span>
          <span class="smoky-btn__content">
            <span class="smoky-roll"><span>{{ section.settings.order_button }}</span><span class="smoky-roll__dup">{{ section.settings.order_button }}</span></span>
          </span>
        </span>
      </a>

      <div class="smoky-funnel__card smoky-funnel__card--visit" data-smoky-reveal data-smoky-reveal-delay="0.12">
        <svg class="smoky-dotted-frame" aria-hidden="true" preserveAspectRatio="none">
          <rect style="x:1px;y:1px;width:calc(100% - 2px);height:calc(100% - 2px)" rx="24" stroke="var(--smoky-pink)"></rect>
        </svg>
        <span class="smoky-funnel__badge" aria-hidden="true">
          <img src="{{ 'smoky-badge-cream.svg' | asset_url }}" alt="" loading="lazy" width="88" height="132">
        </span>
        <span class="smoky-kicker smoky-funnel__kicker">{{ section.settings.visit_kicker }}</span>
        <span class="smoky-funnel__title">{{ section.settings.visit_title }}</span>
        <span class="smoky-funnel__text">{{ section.settings.visit_text }}</span>
        <dl class="smoky-funnel__facts">
          {%- if section.settings.address != blank -%}
            <div><dt>Адрес</dt><dd>{{ section.settings.address }}</dd></div>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <div><dt>Работно време</dt><dd>{{ section.settings.hours }}</dd></div>
          {%- endif -%}
        </dl>
        <span class="smoky-funnel__actions">
          {%- if section.settings.map_link != blank -%}
            <a href="{{ section.settings.map_link }}" target="_blank" rel="noopener" class="smoky-btn smoky-funnel__btn">
              <span class="smoky-btn__shadow"></span>
              <span class="smoky-btn__content">
                <span class="smoky-roll"><span>{{ section.settings.map_button }}</span><span class="smoky-roll__dup">{{ section.settings.map_button }}</span></span>
              </span>
            </a>
          {%- endif -%}
          {%- if section.settings.reserve_link != blank -%}
            <a href="{{ section.settings.reserve_link }}" class="smoky-btn smoky-btn--sand smoky-funnel__btn">
              <span class="smoky-btn__shadow"></span>
              <span class="smoky-btn__content">
                <span class="smoky-roll"><span>{{ section.settings.reserve_button }}</span><span class="smoky-roll__dup">{{ section.settings.reserve_button }}</span></span>
              </span>
            </a>
          {%- endif -%}
        </span>
      </div>
    </div>

    {%- if section.settings.phone != blank -%}
      <p class="smoky-funnel__phone" data-smoky-reveal>
        {{ section.settings.phone_label }}
        <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="smoky-link">{{ section.settings.phone }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

<style>
  #smoky-funnel-{{ section.id }} {
    background: var(--smoky-cream);
    color: var(--smoky-dark);
    padding-block: clamp(64px, 9vw, 130px);
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__head {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__lead {
    margin: clamp(12px, 1.6vw, 20px) auto 0;
    max-width: 44ch;
    font-family: var(--smoky-font-body);
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    line-height: 1.5;
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 44px);
    align-items: stretch;
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(10px, 1.2vw, 16px);
    padding: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 44px) clamp(28px, 3.4vw, 44px);
    border: var(--smoky-border);
    border-radius: var(--smoky-radius);
    box-shadow: 0 0.45em 0 var(--smoky-shadow-color);
    text-decoration: none;
    transition: transform var(--smoky-anim-bounce);
  }

  #smoky-funnel-{{ section.id }} a.smoky-funnel__card:hover { transform: translateY(-6px) rotate(-0.6deg); }

  #smoky-funnel-{{ section.id }} .smoky-funnel__card--order {
    background: var(--smoky-pink);
    color: var(--smoky-cream);
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__card--visit {
    background: var(--smoky-dark-soft);
    color: var(--smoky-sand);
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__kicker { opacity: 0.85; }

  #smoky-funnel-{{ section.id }} .smoky-funnel__title {
    font-family: var(--smoky-font-heading);
    font-weight: 800;
    font-size: clamp(2rem, 3.4vw, 3.4rem);
    line-height: 0.95;
    text-transform: uppercase;
    max-width: 9em;
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__text {
    font-family: var(--smoky-font-body);
    font-size: clamp(0.98rem, 1.15vw, 1.1rem);
    line-height: 1.55;
    max-width: 34ch;
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__btn { margin-top: auto; padding-top: clamp(12px, 1.4vw, 20px); }

  #smoky-funnel-{{ section.id }} .smoky-funnel__mascot {
    position: absolute;
    right: clamp(14px, 2vw, 30px);
    top: clamp(-30px, -2.4vw, -18px);
    width: clamp(88px, 9vw, 140px);
    transform: rotate(8deg);
    filter: drop-shadow(0 8px 12px rgb(40 40 40 / 0.35));
    pointer-events: none;
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__mascot img,
  #smoky-funnel-{{ section.id }} .smoky-funnel__badge img { width: 100%; height: auto; display: block; }

  #smoky-funnel-{{ section.id }} .smoky-funnel__badge {
    position: absolute;
    right: clamp(18px, 2.4vw, 36px);
    top: clamp(-26px, -2vw, -14px);
    width: clamp(64px, 6.2vw, 92px);
    transform: rotate(-6deg);
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.4));
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__facts {
    display: grid;
    gap: 10px;
    margin: 4px 0 0;
    width: 100%;
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__facts div {
    display: grid;
    grid-template-columns: 9em 1fr;
    gap: 12px;
    padding-top: 10px;
    border-top: 2px dotted rgb(235 220 195 / 0.35);
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__facts dt {
    font-family: var(--smoky-font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--smoky-pink);
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__facts dd {
    margin: 0;
    font-family: var(--smoky-font-body);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.45;
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
    padding-top: clamp(12px, 1.4vw, 20px);
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__actions .smoky-funnel__btn { margin-top: 0; padding-top: 0; }

  #smoky-funnel-{{ section.id }} .smoky-funnel__phone {
    margin: clamp(28px, 3.4vw, 48px) 0 0;
    text-align: center;
    font-family: var(--smoky-font-body);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
  }

  #smoky-funnel-{{ section.id }} .smoky-funnel__phone .smoky-link {
    margin-left: 0.4em;
    color: var(--smoky-pink);
    font-size: 1.15em;
  }

  @media screen and (max-width: 849px) {
    #smoky-funnel-{{ section.id }} .smoky-funnel__paths { grid-template-columns: 1fr; gap: 44px; }
    #smoky-funnel-{{ section.id }} .smoky-funnel__facts div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>

{% schema %}
{
  "name": "Smoky фуния (поръчай/ела)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заглавие", "default": "ОГЛАДНЯ ЛИ?" },
    { "type": "textarea", "id": "text", "label": "Текст", "default": "Два пътя до скарата — горещо до вратата ти или на маса при нас, до жарта." },
    { "type": "header", "content": "Поръчай онлайн" },
    { "type": "text", "id": "order_kicker", "label": "Малък надпис", "default": "Доставка" },
    { "type": "text", "id": "order_title", "label": "Заглавие", "default": "ПОРЪЧАЙ ОНЛАЙН" },
    { "type": "textarea", "id": "order_text", "label": "Текст", "default": "Избираш от менюто, ние палим жарта. Средно 30–45 минути до твоята врата, в брандирана термо опаковка." },
    { "type": "text", "id": "order_button", "label": "Бутон", "default": "Към менюто" },
    { "type": "url", "id": "order_link", "label": "Линк" },
    { "type": "header", "content": "Ела на място" },
    { "type": "text", "id": "visit_kicker", "label": "Малък надпис", "default": "Ресторантът" },
    { "type": "text", "id": "visit_title", "label": "Заглавие", "default": "ЕЛА НА МЯСТО" },
    { "type": "textarea", "id": "visit_text", "label": "Текст", "default": "Скарата е най-вкусна до огъня. Ела да я усетиш на живо — с топъл хляб, студена бира и Димо на бара." },
    { "type": "text", "id": "address", "label": "Адрес", "default": "ул. Скара 1, София" },
    { "type": "text", "id": "hours", "label": "Работно време", "default": "Пон–Нед 11:00–23:00" },
    { "type": "text", "id": "map_button", "label": "Бутон карта", "default": "Виж на картата" },
    { "type": "url", "id": "map_link", "label": "Линк към картата" },
    { "type": "text", "id": "reserve_button", "label": "Бутон резервация", "default": "Резервирай маса" },
    { "type": "url", "id": "reserve_link", "label": "Линк за резервация" },
    { "type": "header", "content": "Телефон" },
    { "type": "text", "id": "phone_label", "label": "Текст преди телефона", "default": "Или просто звънни:" },
    { "type": "text", "id": "phone", "label": "Телефон", "default": "+359 88 888 8888" },
    { "type": "checkbox", "id": "curve_top", "label": "Заоблен горен ръб (над тъмно)", "default": false },
    { "type": "checkbox", "id": "curve_bottom", "label": "Заоблен долен ръб (над тъмно)", "default": true }
  ],
  "presets": [{ "name": "Smoky фуния (поръчай/ела)" }]
}
{% endschema %}
