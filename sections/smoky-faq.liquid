{% comment %}
  Smoky FAQ accordion — FTC anatomy: each item has a question row with a
  round sticker "+" button (rotates to ×) and a height-animated answer.
  Optional group heading above the list. Native <details>-free implementation
  for the animated height; accessible via button + aria-expanded.
{% endcomment %}

<section class="smoky-faq smoky-grained{% if section.settings.curve_top %} smoky-curl-top{% endif %}{% if section.settings.curve_bottom %} smoky-curl-bottom{% endif %}" id="smoky-faq-{{ section.id }}">
  <div class="smoky-container smoky-container--small">
    {%- if section.settings.heading != blank -%}
      <h2 class="smoky-title smoky-title--small smoky-faq__heading" data-smoky-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="smoky-faq__list">
      {%- for block in section.blocks -%}
        <li class="smoky-faq__item smoky-grained" data-smoky-reveal {% unless forloop.first %}data-smoky-reveal-delay="{{ forloop.index0 | times: 0.04 }}"{% endunless %} {{ block.shopify_attributes }}>
          <button type="button" class="smoky-faq__top" aria-expanded="false" aria-controls="smoky-faq-a-{{ block.id }}">
            <h3>{{ block.settings.question }}</h3>
            <span class="smoky-faq__toggle" aria-hidden="true">
              <span class="smoky-faq__toggle-shadow"></span>
              <span class="smoky-faq__toggle-fill">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
              </span>
            </span>
          </button>
          <div class="smoky-faq__bottom" id="smoky-faq-a-{{ block.id }}" hidden>
            <div class="smoky-faq__answer">{{ block.settings.answer }}</div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  #smoky-faq-{{ section.id }} {
    background: var(--smoky-cream);
    color: var(--smoky-dark);
    padding-block: clamp(56px, 8vw, 120px);
  }

  #smoky-faq-{{ section.id }} .smoky-faq__heading { margin-bottom: clamp(28px, 4vw, 48px); }

  #smoky-faq-{{ section.id }} .smoky-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.4vw, 18px);
  }

  #smoky-faq-{{ section.id }} .smoky-faq__item {
    background: var(--smoky-sand);
    border: var(--smoky-border);
    border-radius: clamp(18px, 2vw, 28px);
    overflow: hidden;
  }

  #smoky-faq-{{ section.id }} .smoky-faq__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: 100%;
    padding: clamp(16px, 2vw, 26px) clamp(18px, 2.4vw, 32px);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: inherit;
  }

  #smoky-faq-{{ section.id }} .smoky-faq__top h3 {
    margin: 0;
    font-family: var(--smoky-font-heading);
    font-weight: 600;
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  #smoky-faq-{{ section.id }} .smoky-faq__toggle {
    position: relative;
    flex: 0 0 auto;
    width: 2.6em;
    height: 2.6em;
  }

  #smoky-faq-{{ section.id }} .smoky-faq__toggle-shadow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--smoky-shadow-color);
    transform: translateY(0.2em);
  }

  #smoky-faq-{{ section.id }} .smoky-faq__toggle-fill {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border: var(--smoky-border);
    border-radius: 50%;
    background: var(--smoky-pink);
    color: var(--smoky-cream);
    transition: transform var(--smoky-anim-bounce);
  }

  #smoky-faq-{{ section.id }} .smoky-faq__toggle-fill svg {
    width: 45%;
    height: 45%;
    transition: transform 0.45s var(--smoky-bounce);
  }

  #smoky-faq-{{ section.id }} .smoky-faq__top:hover .smoky-faq__toggle-fill { transform: translateY(-0.15em); }

  #smoky-faq-{{ section.id }} .smoky-faq__top[aria-expanded='true'] .smoky-faq__toggle-fill svg { transform: rotate(135deg); }

  #smoky-faq-{{ section.id }} .smoky-faq__bottom {
    overflow: hidden;
    transition: height 0.45s var(--smoky-ease);
  }

  #smoky-faq-{{ section.id }} .smoky-faq__answer {
    padding: 0 clamp(18px, 2.4vw, 32px) clamp(18px, 2.2vw, 28px);
    font-family: var(--smoky-font-body);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.55;
    max-width: 62ch;
  }

  #smoky-faq-{{ section.id }} .smoky-faq__answer p { margin: 0 0 0.8em; }
  #smoky-faq-{{ section.id }} .smoky-faq__answer p:last-child { margin-bottom: 0; }
  #smoky-faq-{{ section.id }} .smoky-faq__answer a { color: var(--smoky-pink); }
</style>

<script>
  (() => {
    const root = document.getElementById('smoky-faq-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('.smoky-faq__top').forEach((top) => {
      const bottom = document.getElementById(top.getAttribute('aria-controls'));
      top.addEventListener('click', () => {
        const open = top.getAttribute('aria-expanded') === 'true';
        top.setAttribute('aria-expanded', String(!open));
        if (open) {
          bottom.style.height = bottom.scrollHeight + 'px';
          requestAnimationFrame(() => (bottom.style.height = '0px'));
          bottom.addEventListener('transitionend', () => { bottom.hidden = true; bottom.style.height = ''; }, { once: true });
        } else {
          bottom.hidden = false;
          bottom.style.height = '0px';
          requestAnimationFrame(() => (bottom.style.height = bottom.scrollHeight + 'px'));
          bottom.addEventListener('transitionend', () => (bottom.style.height = ''), { once: true });
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Smoky ЧЗВ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие (по избор)"
    },
    {
      "type": "checkbox",
      "id": "curve_top",
      "label": "Заоблен горен ръб (над тъмно)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "curve_bottom",
      "label": "Заоблен долен ръб (над тъмно)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Въпрос",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Въпрос",
          "default": "Къде доставяте?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Отговор",
          "default": "<p>Доставяме в цяла София — бързо, горещо и с усмивка.</p>"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Smoky ЧЗВ",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "question": "Къде доставяте?",
            "answer": "<p>Доставяме в цяла София. Виж точните квартали и времената при завършване на поръчката — а ако твоят район още не е в списъка, пиши ни и ще направим всичко възможно.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Колко време отнема доставката?",
            "answer": "<p>Средно около 30–45 минути. Готвим на момента — месото тръгва към жарта чак когато поръчката ти пристигне при нас, затова всяка минута си заслужава.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Има ли минимална поръчка?",
            "answer": "<p>Да — минималната стойност за доставка е 20 лв. За по-малки поръчки можеш да вземеш храната си на място от ресторанта.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Как се плаща?",
            "answer": "<p>Онлайн с карта или в брой/с карта при доставка — както ти е удобно.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
