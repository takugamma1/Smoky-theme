{% comment %}
  Smoky menu products — delivery menu as a product grid with collection
  filter pills. Pills: selected = pink fill + dark text, others = dark
  outline. Each product photo is clipped into an organic blob and sits on a
  pink + dark-grey blob composition (4 rotating variants), info underneath:
  name, short description, price and an order pill. Blocks = collections.
{% endcomment %}

{%- assign blob_a = 'M44.6,-57.2C57.7,-46.8,68.2,-32.6,72.4,-16.5C76.6,-0.4,74.5,17.6,66.3,32.1C58,46.7,43.6,57.8,27.8,64.3C12,70.8,-5.2,72.7,-21.4,68.3C-37.6,63.9,-52.8,53.1,-62.7,38.5C-72.6,23.9,-77.2,5.4,-73.2,-10.6C-69.2,-26.6,-56.6,-40.1,-42.6,-50.4C-28.6,-60.7,-14.3,-67.8,1,-69.1C16.3,-70.4,31.5,-67.6,44.6,-57.2Z' -%}
{%- assign blob_b = 'M38.1,-46.9C50.9,-38.9,63.6,-28.3,68.7,-14.5C73.8,-0.7,71.3,16.3,63.2,30.1C55.1,43.9,41.4,54.5,26.3,60.8C11.2,67.1,-5.3,69.1,-20.9,64.9C-36.5,60.7,-51.2,50.3,-59.9,36.4C-68.6,22.5,-71.3,5.1,-67.6,-10.3C-63.9,-25.7,-53.8,-39.1,-41.1,-47.4C-28.4,-55.7,-14.2,-58.9,-0.2,-58.7C13.8,-58.5,27.6,-54.9,38.1,-46.9Z' -%}
{%- assign blob_c = 'M31.4,-38.3C41.9,-30.4,52.1,-21.5,56.6,-9.7C61.1,2.1,59.9,16.8,52.8,27.6C45.7,38.4,32.7,45.3,19.2,50.2C5.7,55.1,-8.3,58,-21.1,54.4C-33.9,50.8,-45.5,40.7,-52.1,27.9C-58.7,15.1,-60.3,-0.4,-56,-13.6C-51.7,-26.8,-41.5,-37.7,-29.8,-45.4C-18.1,-53.1,-4.9,-57.6,5.6,-64.3C16.1,-71,20.9,-46.2,31.4,-38.3Z' -%}

<section class="smoky-mp smoky-grained{% if section.settings.curve_top %} smoky-curl-top{% endif %}{% if section.settings.curve_bottom %} smoky-curl-bottom{% endif %}" id="smoky-mp-{{ section.id }}">
  <div class="smoky-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="smoky-title smoky-title--small smoky-mp__heading" data-smoky-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- assign has_cols = false -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank -%}{%- assign has_cols = true -%}{%- endif -%}
    {%- endfor -%}

    {%- if has_cols -%}
      <div class="smoky-mp__pills" role="tablist" data-smoky-reveal>
        {%- assign first = true -%}
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- if c != blank -%}
            <button
              type="button"
              class="smoky-mp__pill{% if first %} is-active{% endif %}"
              role="tab"
              aria-selected="{% if first %}true{% else %}false{% endif %}"
              data-panel="mp-panel-{{ block.id }}"
              {{ block.shopify_attributes }}
            >{% if block.settings.title != blank %}{{ block.settings.title }}{% else %}{{ c.title }}{% endif %}</button>
            {%- assign first = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- assign first_panel = true -%}
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          <div class="smoky-mp__panel" id="mp-panel-{{ block.id }}" {% unless first_panel %}hidden{% endunless %}>
            <div class="smoky-mp__grid">
              {%- for product in c.products limit: section.settings.limit -%}
                {%- assign v = forloop.index0 | modulo: 4 | plus: 1 -%}
                <article class="smoky-mp__card smoky-mp__card--v{{ v }}" data-smoky-reveal>
                  <a href="{{ product.url }}" class="smoky-mp__media" aria-label="{{ product.title | escape }}">
                    <svg class="smoky-mp__blob smoky-mp__blob--pink" viewBox="-100 -100 200 200" aria-hidden="true"><path d="{{ blob_a }}" fill="var(--smoky-pink)"/></svg>
                    <svg class="smoky-mp__blob smoky-mp__blob--dark" viewBox="-100 -100 200 200" aria-hidden="true"><path d="{{ blob_c }}" fill="var(--smoky-dark)"/></svg>
                    <svg class="smoky-mp__blob smoky-mp__blob--dot" viewBox="-100 -100 200 200" aria-hidden="true"><path d="{{ blob_b }}" fill="var(--smoky-dark)"/></svg>
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 30vw, 45vw', class: 'smoky-mp__img' }}
                    {%- else -%}
                      <img src="{{ 'smoky-stamp-smoky.svg' | asset_url }}" alt="" loading="lazy" width="300" height="300" class="smoky-mp__img smoky-mp__img--ph">
                    {%- endif -%}
                  </a>
                  <div class="smoky-mp__info">
                    <h3 class="smoky-mp__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                    {%- assign desc = product.description | strip_html | truncate: 80 -%}
                    {%- if desc != blank -%}<p class="smoky-mp__desc">{{ desc }}</p>{%- endif -%}
                    <div class="smoky-mp__row">
                      <span class="smoky-mp__price">{{ product.price | money }}</span>
                      <a href="{{ product.url }}" class="smoky-btn smoky-mp__btn">
                        <span class="smoky-btn__shadow"></span>
                        <span class="smoky-btn__content">
                          <span class="smoky-roll"><span>{{ section.settings.button_label }}</span><span class="smoky-roll__dup">{{ section.settings.button_label }}</span></span>
                        </span>
                      </a>
                    </div>
                  </div>
                </article>
              {%- else -%}
                <p class="smoky-mp__empty">В тази категория още няма продукти.</p>
              {%- endfor -%}
            </div>
          </div>
          {%- assign first_panel = false -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- # demo state so the design reads before collections are assigned -%}
      <div class="smoky-mp__pills" role="tablist">
        {%- assign demo_tabs = 'Скара,Сач,Гарнитури,Салати,Десерти' | split: ',' -%}
        {%- for t in demo_tabs -%}
          <button type="button" class="smoky-mp__pill{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ t }}</button>
        {%- endfor -%}
      </div>
      <div class="smoky-mp__panel">
        <div class="smoky-mp__grid">
          {%- assign demo = 'Кебапче класик|прясно смляно телешко, чубрица|3,20 лв.;Кюфте по селски|телешко и свинско, лук, кимион|3,40 лв.;Свински врат на жар|300 г, зелена салка|14,90 лв.;Пилешки филенца|мариновани, на дървени въглища|11,50 лв.;Сач за двама|свинско, пилешко, зеленчуци|29,90 лв.;Картофки с лютеница|на жар, с домашна лютеница|5,90 лв.' | split: ';' -%}
          {%- for row in demo -%}
            {%- assign parts = row | split: '|' -%}
            {%- assign v = forloop.index0 | modulo: 4 | plus: 1 -%}
            <article class="smoky-mp__card smoky-mp__card--v{{ v }}">
              <span class="smoky-mp__media">
                <svg class="smoky-mp__blob smoky-mp__blob--pink" viewBox="-100 -100 200 200" aria-hidden="true"><path d="{{ blob_a }}" fill="var(--smoky-pink)"/></svg>
                <svg class="smoky-mp__blob smoky-mp__blob--dark" viewBox="-100 -100 200 200" aria-hidden="true"><path d="{{ blob_c }}" fill="var(--smoky-dark)"/></svg>
                <svg class="smoky-mp__blob smoky-mp__blob--dot" viewBox="-100 -100 200 200" aria-hidden="true"><path d="{{ blob_b }}" fill="var(--smoky-dark)"/></svg>
                <img src="{{ 'smoky-stamp-smoky.svg' | asset_url }}" alt="" loading="lazy" width="300" height="300" class="smoky-mp__img smoky-mp__img--ph">
              </span>
              <div class="smoky-mp__info">
                <h3 class="smoky-mp__name">{{ parts[0] }}</h3>
                <p class="smoky-mp__desc">{{ parts[1] }}</p>
                <div class="smoky-mp__row">
                  <span class="smoky-mp__price">{{ parts[2] }}</span>
                  <span class="smoky-btn smoky-mp__btn"><span class="smoky-btn__shadow"></span><span class="smoky-btn__content">{{ section.settings.button_label }}</span></span>
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #smoky-mp-{{ section.id }} {
    background: var(--smoky-cream);
    color: var(--smoky-dark);
    padding-block: clamp(10px, 1.4vw, 22px) clamp(64px, 8vw, 120px);
  }

  #smoky-mp-{{ section.id }} .smoky-mp__heading {
    text-align: center;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  /* ---- collection pills ---- */
  #smoky-mp-{{ section.id }} .smoky-mp__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(10px, 1.2vw, 16px);
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  #smoky-mp-{{ section.id }} .smoky-mp__pill {
    height: clamp(44px, 3.6vw, 54px);
    padding-inline: clamp(20px, 2vw, 30px);
    border: var(--smoky-border);
    border-radius: 999px;
    background: transparent;
    color: var(--smoky-dark);
    font-family: var(--smoky-font-heading);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: transform var(--smoky-anim-bounce), background-color 0.25s ease, box-shadow 0.25s ease;
  }

  #smoky-mp-{{ section.id }} .smoky-mp__pill:hover { transform: translateY(-3px); }

  #smoky-mp-{{ section.id }} .smoky-mp__pill.is-active {
    background: var(--smoky-pink);
    color: var(--smoky-dark);
    box-shadow: 0 0.25em 0 var(--smoky-shadow-color);
  }

  /* ---- grid ---- */
  #smoky-mp-{{ section.id }} .smoky-mp__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3.5vw, 56px) clamp(20px, 2.6vw, 40px);
  }

  #smoky-mp-{{ section.id }} .smoky-mp__empty {
    grid-column: 1 / -1;
    font-family: var(--smoky-font-body);
    opacity: 0.7;
  }

  /* ---- blob media ---- */
  #smoky-mp-{{ section.id }} .smoky-mp__media {
    position: relative;
    display: block;
    aspect-ratio: 1;
    text-decoration: none;
  }

  #smoky-mp-{{ section.id }} .smoky-mp__blob {
    position: absolute;
    display: block;
    transition: transform 0.6s var(--smoky-bounce);
  }

  #smoky-mp-{{ section.id }} .smoky-mp__blob--pink { width: 78%; height: 78%; z-index: 0; }
  #smoky-mp-{{ section.id }} .smoky-mp__blob--dark { width: 30%; height: 30%; z-index: 2; }
  #smoky-mp-{{ section.id }} .smoky-mp__blob--dot { width: 13%; height: 13%; z-index: 2; opacity: 0.9; }

  #smoky-mp-{{ section.id }} .smoky-mp__img {
    position: absolute;
    z-index: 1;
    width: 70%;
    height: 70%;
    object-fit: cover;
    /* organic blob clip for regular photos */
    border-radius: 58% 42% 50% 50% / 46% 55% 45% 54%;
    filter: drop-shadow(0 14px 18px rgb(40 40 40 / 0.22));
    transition: transform 0.55s var(--smoky-bounce);
  }

  #smoky-mp-{{ section.id }} .smoky-mp__img--ph {
    object-fit: contain;
    border-radius: 0;
    width: 46%;
    height: 46%;
    opacity: 0.55;
    filter: none;
  }

  /* four compositions so the grid feels hand-placed */
  #smoky-mp-{{ section.id }} .smoky-mp__card--v1 .smoky-mp__blob--pink { left: 8%; top: 4%; transform: rotate(-12deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v1 .smoky-mp__blob--dark { right: 4%; bottom: 10%; transform: rotate(20deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v1 .smoky-mp__blob--dot { left: 6%; bottom: 14%; }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v1 .smoky-mp__img { left: 15%; top: 14%; border-radius: 58% 42% 50% 50% / 46% 55% 45% 54%; }

  #smoky-mp-{{ section.id }} .smoky-mp__card--v2 .smoky-mp__blob--pink { right: 6%; top: 8%; transform: rotate(24deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v2 .smoky-mp__blob--dark { left: 4%; top: 12%; transform: rotate(-30deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v2 .smoky-mp__blob--dot { right: 10%; bottom: 8%; }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v2 .smoky-mp__img { left: 14%; top: 16%; border-radius: 45% 55% 52% 48% / 55% 45% 55% 45%; }

  #smoky-mp-{{ section.id }} .smoky-mp__card--v3 .smoky-mp__blob--pink { left: 4%; bottom: 6%; transform: rotate(40deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v3 .smoky-mp__blob--dark { right: 8%; top: 4%; transform: rotate(10deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v3 .smoky-mp__blob--dot { left: 12%; top: 10%; }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v3 .smoky-mp__img { left: 16%; top: 12%; border-radius: 52% 48% 40% 60% / 60% 42% 58% 40%; }

  #smoky-mp-{{ section.id }} .smoky-mp__card--v4 .smoky-mp__blob--pink { right: 4%; bottom: 4%; transform: rotate(-32deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v4 .smoky-mp__blob--dark { left: 6%; bottom: 8%; transform: rotate(48deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v4 .smoky-mp__blob--dot { right: 8%; top: 12%; }
  #smoky-mp-{{ section.id }} .smoky-mp__card--v4 .smoky-mp__img { left: 14%; top: 14%; border-radius: 40% 60% 55% 45% / 48% 40% 60% 52%; }

  #smoky-mp-{{ section.id }} .smoky-mp__card:hover .smoky-mp__img { transform: scale(1.05) rotate(-2deg); }
  #smoky-mp-{{ section.id }} .smoky-mp__card:hover .smoky-mp__blob--pink { transform: rotate(0deg) scale(1.06); }
  #smoky-mp-{{ section.id }} .smoky-mp__card:hover .smoky-mp__blob--dark { transform: rotate(0deg) translate(-4%, -4%); }

  /* ---- info below ---- */
  #smoky-mp-{{ section.id }} .smoky-mp__info { padding-top: clamp(10px, 1.2vw, 16px); }

  #smoky-mp-{{ section.id }} .smoky-mp__name {
    margin: 0 0 4px;
    font-family: var(--smoky-font-heading);
    font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.6rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.05;
  }

  #smoky-mp-{{ section.id }} .smoky-mp__name a { color: inherit; text-decoration: none; }
  #smoky-mp-{{ section.id }} .smoky-mp__name a:hover { color: var(--smoky-pink); }

  #smoky-mp-{{ section.id }} .smoky-mp__desc {
    margin: 0 0 10px;
    font-family: var(--smoky-font-body);
    font-size: clamp(0.88rem, 1vw, 0.98rem);
    line-height: 1.45;
    opacity: 0.75;
  }

  #smoky-mp-{{ section.id }} .smoky-mp__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  #smoky-mp-{{ section.id }} .smoky-mp__price {
    font-family: var(--smoky-font-heading);
    font-weight: 800;
    font-size: clamp(1.15rem, 1.5vw, 1.5rem);
  }

  #smoky-mp-{{ section.id }} .smoky-mp__btn { font-size: 0.8rem; }

  @media screen and (max-width: 989px) {
    #smoky-mp-{{ section.id }} .smoky-mp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 599px) {
    #smoky-mp-{{ section.id }} .smoky-mp__grid { grid-template-columns: 1fr; gap: 36px; }
    #smoky-mp-{{ section.id }} .smoky-mp__media { max-width: 340px; margin-inline: auto; }
    #smoky-mp-{{ section.id }} .smoky-mp__info { text-align: center; }
    #smoky-mp-{{ section.id }} .smoky-mp__row { justify-content: center; gap: 18px; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('smoky-mp-{{ section.id }}');
    if (!root) return;
    const pills = root.querySelectorAll('.smoky-mp__pill');
    const panels = root.querySelectorAll('.smoky-mp__panel');
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          p.classList.toggle('is-active', p === pill);
          p.setAttribute('aria-selected', p === pill);
        });
        if (panels.length > 1) {
          panels.forEach((panel) => {
            panel.hidden = panel.id !== pill.dataset.panel;
          });
          // re-run reveals for the freshly shown cards
          root.querySelectorAll('.smoky-mp__panel:not([hidden]) [data-smoky-reveal]').forEach((el) => el.classList.add('is-inview'));
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Smoky меню продукти",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заглавие (по избор)" },
    { "type": "text", "id": "button_label", "label": "Бутон на продуктите", "default": "Поръчай" },
    { "type": "range", "id": "limit", "label": "Максимум продукти на категория", "min": 3, "max": 24, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "curve_top", "label": "Заоблен горен ръб (над тъмно)", "default": false },
    { "type": "checkbox", "id": "curve_bottom", "label": "Заоблен долен ръб (над тъмно)", "default": true }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Категория (колекция)",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Колекция" },
        { "type": "text", "id": "title", "label": "Име на бутона (по избор)" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Smoky меню продукти",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
