{% comment %}
  Smoky photo marquee — the FTC "impression" filmstrip: rounded photo cards
  in an infinite marquee, alternating portrait/square, reversing with scroll
  direction. Each block is one photo.
{% endcomment %}

<section class="smoky-photomq {% if section.settings.background == 'dark' %}smoky-grained--light{% else %}smoky-grained{% endif %}{% if section.settings.curve_top %} smoky-curl-top{% endif %}{% if section.settings.curve_bottom %} smoky-curl-bottom{% endif %}" id="smoky-photomq-{{ section.id }}">
  <div
    data-smoky-marquee
    data-marquee-speed="{{ section.settings.speed }}"
    data-marquee-direction="{{ section.settings.direction }}"
    class="smoky-photomq__viewport"
  >
    <div class="smoky-marquee-track">
      {%- for block in section.blocks -%}
        <figure class="smoky-photomq__card {% cycle 'smoky-photomq__card--tall', 'smoky-photomq__card--square' %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.alt }}
          {%- else -%}
            <div class="smoky-photomq__placeholder">
              <img src="{{ 'smoky-stamp-smoky.svg' | asset_url }}" alt="" loading="lazy" width="200" height="200">
            </div>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #smoky-photomq-{{ section.id }} {
    background: {% if section.settings.background == 'dark' %}var(--smoky-dark-soft){% else %}var(--smoky-cream){% endif %};
    /* clear the curled corners: padding always exceeds the curl radius */
    padding-block: calc(var(--smoky-radius-big) + clamp(16px, 2vw, 28px));
    overflow: clip;
  }

  #smoky-photomq-{{ section.id }} .smoky-photomq__viewport { overflow: hidden; }

  #smoky-photomq-{{ section.id }} .smoky-photomq__card {
    margin: 0 clamp(8px, 1.2vw, 18px) 0 0;
    width: clamp(200px, 20vw, 320px);
    border-radius: var(--smoky-radius);
    border: var(--smoky-border);
    overflow: hidden;
    background: var(--smoky-sand);
  }

  #smoky-photomq-{{ section.id }} .smoky-photomq__card--tall { aspect-ratio: 5 / 6; }
  #smoky-photomq-{{ section.id }} .smoky-photomq__card--square { aspect-ratio: 1; align-self: center; }

  #smoky-photomq-{{ section.id }} .smoky-photomq__card img,
  #smoky-photomq-{{ section.id }} .smoky-photomq__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #smoky-photomq-{{ section.id }} .smoky-photomq__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #smoky-photomq-{{ section.id }} .smoky-photomq__placeholder img {
    width: 56% !important;
    height: auto !important;
    object-fit: contain !important;
    opacity: 0.45;
  }

  #smoky-photomq-{{ section.id }} .smoky-marquee-track { align-items: center; }
</style>

{% schema %}
{
  "name": "Smoky фото маркии",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Фон",
      "options": [
        {
          "value": "cream",
          "label": "Крем"
        },
        {
          "value": "dark",
          "label": "Тъмен"
        }
      ],
      "default": "cream"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Скорост (px/сек)",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 50
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Посока",
      "options": [
        {
          "value": "left",
          "label": "Наляво"
        },
        {
          "value": "right",
          "label": "Надясно"
        }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "curve_top",
      "label": "Заоблен горен ръб (над тъмно)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "curve_bottom",
      "label": "Заоблен долен ръб (над тъмно)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Снимка",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Снимка"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Алт текст"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Smoky фото маркии",
      "blocks": [
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        }
      ]
    }
  ]
}
{% endschema %}
