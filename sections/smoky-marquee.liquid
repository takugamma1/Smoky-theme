{% comment %}
  Smoky marquee — infinite auto-scrolling strip that reverses with scroll
  direction (GSAP). Blocks are words or logo images; between items sits a
  brand separator (shevitsa / flame / fork / knife SVG or a pink dot).
  Use for "СКАРА • ЖАР • ДИМ • ВКУС" strips or partner logos.
{% endcomment %}

<section class="smoky-marquee {% if section.settings.background == 'dark' %}smoky-grained--light{% else %}smoky-grained{% endif %}" id="smoky-marquee-{{ section.id }}">
  <div
    data-smoky-marquee
    data-marquee-speed="{{ section.settings.speed }}"
    data-marquee-direction="{{ section.settings.direction }}"
    class="smoky-marquee__viewport"
    aria-hidden="true"
  >
    <div class="smoky-marquee-track">
      {%- for block in section.blocks -%}
        <div class="smoky-marquee__item" {{ block.shopify_attributes }}>
          {%- if block.type == 'word' -%}
            <span class="smoky-marquee__word{% if block.settings.outline %} smoky-marquee__word--outline{% endif %}">{{ block.settings.text }}</span>
          {%- else -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.alt, class: 'smoky-marquee__logo' }}
            {%- endif -%}
          {%- endif -%}
          {%- unless section.settings.separator == 'none' -%}
            <span class="smoky-marquee__sep">
              {%- case section.settings.separator -%}
                {%- when 'dot' -%}
                  <span class="smoky-marquee__dot"></span>
                {%- else -%}
                  {%- assign sep_url = section.settings.separator | append: '.svg' | asset_url -%}
                  {%- assign sep_reps = section.settings.sep_repeat | default: 3 -%}
                  {%- for i in (1..sep_reps) -%}
                    <span class="smoky-marquee__icon" style="--sep-url: url('{{ sep_url }}')"></span>
                  {%- endfor -%}
              {%- endcase -%}
            </span>
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #smoky-marquee-{{ section.id }} {
    background: {% if section.settings.background == 'dark' %}var(--smoky-dark-soft){% elsif section.settings.background == 'pink' %}var(--smoky-pink){% elsif section.settings.background == 'sand' %}var(--smoky-sand){% else %}var(--smoky-cream){% endif %};
    color: {% if section.settings.background == 'dark' %}var(--smoky-sand){% elsif section.settings.background == 'pink' %}var(--smoky-cream){% else %}var(--smoky-dark){% endif %};
    /* tall enough that the light sections curling over both edges leave a full band visible */
    padding-block: calc(var(--smoky-radius-big) + clamp(20px, 2.5vw, 36px));
    overflow: clip;
    {% if section.settings.curve_top %}border-top-left-radius: min(var(--smoky-radius-big), 40px); border-top-right-radius: min(var(--smoky-radius-big), 40px);{% endif %}
    {% if section.settings.curve_bottom %}border-bottom-left-radius: min(var(--smoky-radius-big), 40px); border-bottom-right-radius: min(var(--smoky-radius-big), 40px);{% endif %}
  }

  #smoky-marquee-{{ section.id }} .smoky-marquee__viewport { overflow: hidden; }

  #smoky-marquee-{{ section.id }} .smoky-marquee__item {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.6vw, 26px);
    padding-right: clamp(14px, 1.6vw, 26px);
  }

  #smoky-marquee-{{ section.id }} .smoky-marquee__sep {
    display: flex;
    align-items: center;
    gap: clamp(6px, 0.7vw, 11px);
  }

  #smoky-marquee-{{ section.id }} .smoky-marquee__icon {
    display: block;
    width: clamp(24px, 2.6vw, 40px);
    height: clamp(24px, 2.6vw, 40px);
    background: currentColor;
    -webkit-mask: var(--sep-url) center / contain no-repeat;
    mask: var(--sep-url) center / contain no-repeat;
  }

  #smoky-marquee-{{ section.id }} .smoky-marquee__word {
    font-family: var(--smoky-font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, {{ section.settings.size }}vw, {{ section.settings.size | times: 16 }}px);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  #smoky-marquee-{{ section.id }} .smoky-marquee__word--outline {
    color: transparent;
    -webkit-text-stroke: 2px currentColor;
    -webkit-text-stroke-color: {% if section.settings.background == 'dark' %}var(--smoky-sand){% elsif section.settings.background == 'pink' %}var(--smoky-cream){% else %}var(--smoky-dark){% endif %};
  }

  #smoky-marquee-{{ section.id }} .smoky-marquee__logo {
    height: clamp(30px, 3.4vw, 54px);
    width: auto;
    object-fit: contain;
  }

  #smoky-marquee-{{ section.id }} .smoky-marquee__sep img {
    height: clamp(20px, 2.2vw, 36px);
    width: auto;
    display: block;
  }

  #smoky-marquee-{{ section.id }} .smoky-marquee__dot {
    display: block;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--smoky-pink);
  }
</style>

{% schema %}
{
  "name": "Smoky маркии лента",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Фон",
      "options": [
        {
          "value": "cream",
          "label": "Крем"
        },
        {
          "value": "sand",
          "label": "Пясък"
        },
        {
          "value": "pink",
          "label": "Розово"
        },
        {
          "value": "dark",
          "label": "Тъмен"
        }
      ],
      "default": "dark"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Разделител",
      "options": [
        {
          "value": "none",
          "label": "Без"
        },
        {
          "value": "dot",
          "label": "Точка"
        },
        {
          "value": "smoky-pattern-shevitsa",
          "label": "Шевица"
        },
        {
          "value": "smoky-flame-sticker",
          "label": "Пламък"
        },
        {
          "value": "smoky-pattern-fork",
          "label": "Вилица"
        },
        {
          "value": "smoky-pattern-knife",
          "label": "Нож"
        }
      ],
      "default": "smoky-pattern-shevitsa"
    },
    {
      "type": "range",
      "id": "sep_repeat",
      "label": "Брой икони между думите",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "curve_top",
      "label": "Заоблен горен ръб",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "curve_bottom",
      "label": "Заоблен долен ръб",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Скорост (px/сек)",
      "min": 20,
      "max": 160,
      "step": 10,
      "default": 70
    },
    {
      "type": "range",
      "id": "size",
      "label": "Размер на текста (vw)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Посока",
      "options": [
        {
          "value": "left",
          "label": "Наляво"
        },
        {
          "value": "right",
          "label": "Надясно"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Дума",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Текст",
          "default": "СКАРА"
        },
        {
          "type": "checkbox",
          "id": "outline",
          "label": "Само контур",
          "default": false
        }
      ]
    },
    {
      "type": "logo",
      "name": "Лого",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Лого"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Алт текст"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Smoky маркии лента",
      "blocks": [
        {
          "type": "word",
          "settings": {
            "text": "СКАРА"
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "ЖАР",
            "outline": true
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "ДИМ"
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "ВКУС",
            "outline": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
