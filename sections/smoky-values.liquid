{% comment %}
  Smoky values — grid of value cards, each fronted by one of Димо's mascot
  emotions (or a custom image) in a colored circle, with title + text.
  Used on the About page ("Нашите ценности").
{% endcomment %}

<section class="smoky-values {% if section.settings.background == 'dark' %}smoky-grained--light{% else %}smoky-grained{% endif %}{% if section.settings.curve_top %} smoky-curl-top{% endif %}{% if section.settings.curve_bottom %} smoky-curl-bottom{% endif %}" id="smoky-values-{{ section.id }}">
  <div class="smoky-container smoky-container--medium">
    {%- if section.settings.heading != blank -%}
      <h2 class="smoky-title smoky-title--small smoky-values__heading" data-smoky-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>
  <div class="smoky-values__viewport" data-smoky-drag-cursor tabindex="0">
    <div class="smoky-values__grid">
      {%- for block in section.blocks -%}
        <article class="smoky-values__card smoky-grained" data-smoky-reveal {% unless forloop.first %}data-smoky-reveal-delay="{{ forloop.index0 | times: 0.07 }}"{% endunless %} {{ block.shopify_attributes }}>
          <span class="smoky-values__circle" style="--circle-bg: {{ block.settings.circle_color }};">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              <img src="{{ block.settings.mascot | append: '.svg' | asset_url }}" alt="" loading="lazy" width="120" height="120">
            {%- endif -%}
          </span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
  <div class="smoky-container smoky-values__controls">
    <button type="button" class="smoky-arrow smoky-arrow--prev" data-dir="-1" aria-label="Назад">
      <span class="smoky-arrow__shadow"></span>
      <span class="smoky-arrow__fill">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </button>
    <button type="button" class="smoky-arrow" data-dir="1" aria-label="Напред">
      <span class="smoky-arrow__shadow"></span>
      <span class="smoky-arrow__fill">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </button>
  </div>
</section>

<style>
  #smoky-values-{{ section.id }} {
    background: {% if section.settings.background == 'dark' %}var(--smoky-dark-soft){% else %}var(--smoky-cream){% endif %};
    color: {% if section.settings.background == 'dark' %}var(--smoky-sand){% else %}var(--smoky-dark){% endif %};
    padding-block: clamp(56px, 8vw, 120px);
  }

  #smoky-values-{{ section.id }} .smoky-values__heading {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  #smoky-values-{{ section.id }} .smoky-values__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }

  #smoky-values-{{ section.id }} .smoky-values__viewport::-webkit-scrollbar { display: none; }

  /* one line, always: a scroll-snap track instead of a wrapping grid */
  #smoky-values-{{ section.id }} .smoky-values__grid {
    display: flex;
    gap: clamp(20px, 2.6vw, 36px);
    width: max-content;
    padding: 10px max(min(8vw, 96px), calc((100vw - 1200px) / 2 + min(8vw, 96px))) 16px;
  }

  #smoky-values-{{ section.id }} .smoky-values__card {
    flex: 0 0 auto;
    width: clamp(260px, 26vw, 380px);
    scroll-snap-align: center;
  }

  #smoky-values-{{ section.id }} .smoky-values__controls {
    max-width: 1200px;
    display: flex;
    gap: 14px;
    margin-top: clamp(20px, 2.6vw, 36px);
  }

  @media screen and (max-width: 749px) {
    #smoky-values-{{ section.id }} .smoky-values__grid { padding-inline: 5vw; }
    #smoky-values-{{ section.id }} .smoky-values__card { width: 76vw; }
  }

  #smoky-values-{{ section.id }} .smoky-values__card {
    background: var(--smoky-sand);
    border: var(--smoky-border);
    border-radius: var(--smoky-radius);
    padding: clamp(24px, 3vw, 40px) clamp(18px, 2.2vw, 28px);
    text-align: center;
    color: var(--smoky-dark);
    transition: transform var(--smoky-anim-bounce);
  }

  #smoky-values-{{ section.id }} .smoky-values__card:hover { transform: translateY(-8px) rotate(-1deg); }

  #smoky-values-{{ section.id }} .smoky-values__circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(88px, 9vw, 128px);
    height: clamp(88px, 9vw, 128px);
    margin: 0 auto clamp(14px, 1.8vw, 22px);
    border-radius: 50%;
    border: var(--smoky-border);
    background: var(--circle-bg, var(--smoky-pink));
    overflow: hidden;
  }

  #smoky-values-{{ section.id }} .smoky-values__circle img {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  #smoky-values-{{ section.id }} .smoky-values__card h3 {
    margin: 0 0 8px;
    font-family: var(--smoky-font-heading);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.5vw, 1.45rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  #smoky-values-{{ section.id }} .smoky-values__card p {
    margin: 0;
    font-family: var(--smoky-font-body);
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.5;
    opacity: 0.85;
  }
</style>

<script>
  (() => {
    const root = document.getElementById('smoky-values-{{ section.id }}');
    if (!root) return;
    const viewport = root.querySelector('.smoky-values__viewport');
    const card = root.querySelector('.smoky-values__card');
    root.querySelectorAll('.smoky-arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        viewport.scrollBy({ left: (card ? card.offsetWidth + 28 : 320) * parseInt(btn.dataset.dir, 10), behavior: 'smooth' });
      });
    });
    let down = false, startX = 0, startScroll = 0;
    viewport.addEventListener('mousedown', (e) => { down = true; startX = e.pageX; startScroll = viewport.scrollLeft; viewport.style.cursor = 'grabbing'; viewport.style.scrollSnapType = 'none'; });
    window.addEventListener('mouseup', () => { if (!down) return; down = false; viewport.style.cursor = 'grab'; viewport.style.scrollSnapType = ''; });
    window.addEventListener('mousemove', (e) => { if (!down) return; e.preventDefault(); viewport.scrollLeft = startScroll - (e.pageX - startX); });
  })();
</script>

{% schema %}
{
  "name": "Smoky ценности",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие",
      "default": "НАШИТЕ ЦЕННОСТИ"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Фон",
      "options": [
        {
          "value": "cream",
          "label": "Крем"
        },
        {
          "value": "dark",
          "label": "Тъмен"
        }
      ],
      "default": "cream"
    },
    {
      "type": "checkbox",
      "id": "curve_top",
      "label": "Заоблен горен ръб (над тъмно)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "curve_bottom",
      "label": "Заоблен долен ръб (над тъмно)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Ценност",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Заглавие",
          "default": "Истинска жар"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Текст",
          "default": "Готвим само на дървени въглища — без плочи, без компромиси."
        },
        {
          "type": "select",
          "id": "mascot",
          "label": "Емоция на Димо",
          "options": [
            {
              "value": "smoky-mascot-happy",
              "label": "Щастлив"
            },
            {
              "value": "smoky-mascot-smiling",
              "label": "Усмихнат"
            },
            {
              "value": "smoky-mascot-surprised",
              "label": "Изненадан"
            },
            {
              "value": "smoky-mascot-front",
              "label": "Фронтален"
            },
            {
              "value": "smoky-mascot-sad",
              "label": "Тъжен"
            }
          ],
          "default": "smoky-mascot-happy"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Собствена картинка (по избор)"
        },
        {
          "type": "color",
          "id": "circle_color",
          "label": "Цвят на кръга",
          "default": "#FA0082"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Smoky ценности",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "Истинска жар",
            "text": "Готвим само на дървени въглища — без плочи, без компромиси.",
            "mascot": "smoky-mascot-happy",
            "circle_color": "#FA0082"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Прясно всеки ден",
            "text": "Месото се мели сутринта, подправките са си наши, хлябът е топъл.",
            "mascot": "smoky-mascot-smiling",
            "circle_color": "#EBDCC3"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "От Балкана",
            "text": "Рецепти, предавани през поколения — с уважение към традицията.",
            "mascot": "smoky-mascot-front",
            "circle_color": "#EBDCC3"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "С усмивка",
            "text": "Димо и екипът готвим с кеф — и се познава на вкуса.",
            "mascot": "smoky-mascot-surprised",
            "circle_color": "#FA0082"
          }
        }
      ]
    }
  ]
}
{% endschema %}
