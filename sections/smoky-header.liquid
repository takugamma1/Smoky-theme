{% comment %}
  Smoky flame navigation bar.

  Floating pink flame-shaped bar, centered, not full width.
  Desktop: SMOKY wordmark left, menu links right, dot under the active link.
  Mobile: wordmark left, burger right, full-screen drawer menu.
{% endcomment %}

{% liquid
  assign menu = linklists[section.settings.menu]
%}

<header-smoky
  id="header-component"
  class="smoky-header{% if section.settings.sticky %} smoky-header--sticky{% endif %}"
>
  <div class="smoky-nav" style="--smoky-nav-max: {{ section.settings.max_width }}px;">
    <picture>
      <source media="(max-width: 749px)" srcset="{{ 'smoky-flame-nav-mobile.png' | asset_url }}">
      <img
        src="{{ 'smoky-flame-nav-desktop.png' | asset_url }}"
        alt=""
        class="smoky-nav__bg"
        width="1593"
        height="128"
        fetchpriority="high"
      >
    </picture>

    <div class="smoky-nav__inner">
      <a href="{{ routes.root_url }}" class="smoky-nav__logo" aria-label="{{ shop.name }}">
        {% render 'smoky-logo' %}
      </a>

      <nav class="smoky-nav__menu" aria-label="{{ 'accessibility.navigation' | t | default: 'Navigation' }}">
        <ul>
          {%- if menu.links.size > 0 -%}
            {%- for link in menu.links -%}
              <li{% if link.current %} class="is-active" aria-current="page"{% endif %}>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="is-active"><a href="{{ routes.root_url }}">Начало</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Меню</a></li>
            <li><a href="#">За нас</a></li>
            <li><a href="#">Локации</a></li>
            <li><a href="#">Резервации</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <button
        type="button"
        class="smoky-nav__burger"
        aria-expanded="false"
        aria-controls="smoky-drawer"
        aria-label="{{ 'accessibility.open_menu' | t | default: 'Меню' }}"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="smoky-drawer" id="smoky-drawer" hidden>
    <span class="smoky-drawer__flames" aria-hidden="true"></span>
    <img src="{{ 'smoky-wordmark-sand.svg' | asset_url }}" alt="Smoky" width="600" height="200" class="smoky-drawer__wordmark" loading="lazy">
    <button type="button" class="smoky-drawer__close" aria-label="Затвори менюто">
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 10 38 38 M38 10 10 38" stroke="currentColor" stroke-width="9" stroke-linecap="round"/></svg>
    </button>
    <nav aria-label="{{ 'accessibility.navigation' | t | default: 'Navigation' }}">
      <ul>
        {%- if menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            <li{% if link.current %} class="is-active"{% endif %} style="--stagger: {{ forloop.index }}">
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="is-active" style="--stagger: 1"><a href="{{ routes.root_url }}">Начало</a></li>
          <li style="--stagger: 2"><a href="{{ routes.all_products_collection_url }}">Меню</a></li>
          <li style="--stagger: 3"><a href="#">За нас</a></li>
          <li style="--stagger: 4"><a href="#">Локации</a></li>
          <li style="--stagger: 5"><a href="#">Резервации</a></li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
</header-smoky>

<style>
  /* overlay header: takes no layout space, first section starts at the page top */
  .smoky-header {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-block: 16px 8px;
    background: transparent;
  }

  .smoky-header--sticky {
    position: fixed;
  }

  .smoky-nav {
    position: relative;
    width: min(var(--smoky-nav-max, 1150px), 92vw);
    margin-inline: auto;
  }

  .smoky-nav__bg {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  /* content sits in the solid band of the flame (bottom ~54% of the image) */
  .smoky-nav__inner {
    position: absolute;
    inset: 47% 4.2% 9% 5.2%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .smoky-nav__logo {
    display: flex;
    align-items: center;
    height: 100%;
    color: #EBDCC3;
  }

  .smoky-nav__logo:hover {
    color: #EBDCC3;
  }

  .smoky-logo-svg {
    height: 85%;
    max-height: 40px;
    width: auto;
    display: block;
  }

  .smoky-nav__menu {
    padding-right: 2.5%;
  }

  .smoky-nav__menu ul {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3.6vw, 64px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .smoky-nav__menu a {
    position: relative;
    display: inline-block;
    color: #EBDCC3;
    text-decoration: none;
    font-family: var(--font-heading--family, 'Oswald', sans-serif);
    font-weight: 600;
    font-size: clamp(1rem, 1.2vw, 1.25rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-block: 4px 8px;
  }

  .smoky-nav__menu a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 1px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #EBDCC3;
    transform: translateX(-50%) scale(0);
    transition: transform 0.18s ease;
  }

  .smoky-nav__menu li.is-active a::after,
  .smoky-nav__menu a:hover::after {
    transform: translateX(-50%) scale(1);
  }

  .smoky-nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    background: none;
    border: none;
    padding: 6px 2px;
    cursor: pointer;
    height: 100%;
  }

  .smoky-nav__burger span {
    display: block;
    width: 24px;
    height: 3.5px;
    border-radius: 3px;
    background: #EBDCC3;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .smoky-nav__burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }

  .smoky-nav__burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .smoky-nav__burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* full-screen pink flame overlay, revealed with an expanding circle */
  .smoky-drawer {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(28px, 8vh, 64px) 24px 40px;
    background: #FA0082;
    background-image: var(--smoky-grain);
    background-size: 220px;
    overflow-y: auto;
    clip-path: circle(0% at 82% 56px);
    transition: clip-path 0.65s cubic-bezier(0.75, 0, 0.25, 1);
  }

  .smoky-drawer.is-open {
    clip-path: circle(150% at 82% 56px);
  }

  /* tonal flames drifting in the background */
  .smoky-drawer__flames {
    position: fixed;
    inset: -6%;
    pointer-events: none;
    background: #D4006E;
    -webkit-mask: url('{{ 'smoky-flame-sticker.svg' | asset_url }}') 0 0 / clamp(220px, 42vw, 320px) auto repeat;
    mask: url('{{ 'smoky-flame-sticker.svg' | asset_url }}') 0 0 / clamp(220px, 42vw, 320px) auto repeat;
    opacity: 0.45;
    transform: rotate(-4deg) scale(1.1);
  }

  .smoky-drawer__wordmark {
    position: relative;
    width: min(240px, 56vw);
    height: auto;
    margin-bottom: clamp(20px, 5vh, 44px);
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.35, 1.5, 0.6, 1);
    transition-delay: 0.25s;
  }

  .smoky-drawer__close {
    position: relative;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: #F2ECDF;
    width: clamp(56px, 14vw, 72px);
    height: clamp(56px, 14vw, 72px);
    margin-bottom: clamp(16px, 4vh, 36px);
    opacity: 0;
    transform: scale(0.4) rotate(-90deg);
    transition: opacity 0.35s ease, transform 0.5s cubic-bezier(0.35, 1.5, 0.6, 1);
    transition-delay: 0.32s;
  }

  .smoky-drawer__close svg { width: 100%; height: 100%; display: block; }
  .smoky-drawer.is-open .smoky-drawer__close:hover { transform: scale(1.08) rotate(90deg); }

  .smoky-drawer nav { position: relative; }

  .smoky-drawer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(6px, 1.6vh, 16px);
  }

  .smoky-drawer li {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.4s ease, transform 0.55s cubic-bezier(0.35, 1.5, 0.6, 1);
    transition-delay: calc(0.3s + var(--stagger, 1) * 0.07s);
  }

  .smoky-drawer.is-open .smoky-drawer__wordmark,
  .smoky-drawer.is-open .smoky-drawer__close {
    opacity: 1;
    transform: none;
  }

  .smoky-drawer.is-open li {
    opacity: 1;
    transform: none;
  }

  .smoky-drawer a {
    display: inline-block;
    color: #F2ECDF;
    text-decoration: none;
    text-align: center;
    font-family: var(--smoky-font-heading, var(--font-heading--family, sans-serif));
    font-weight: 800;
    font-size: clamp(2.6rem, 11vw, 4.2rem);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .smoky-drawer li.is-active a {
    text-decoration: underline;
    text-decoration-thickness: 5px;
    text-underline-offset: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .smoky-drawer,
    .smoky-drawer li,
    .smoky-drawer__wordmark,
    .smoky-drawer__close {
      transition: none;
    }
  }

  html.smoky-drawer-open,
  html.smoky-drawer-open body {
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .smoky-header {
      padding-block: 22px 6px;
    }

    .smoky-nav {
      width: 88vw;
    }

    /* mobile flame image band (2146x408, solid bottom ~52%) */
    .smoky-nav__inner {
      inset: 48% 6.5% 7% 7%;
    }

    .smoky-logo-svg {
      height: 82%;
      max-height: 42px;
    }

    .smoky-nav__menu {
      display: none;
    }

    .smoky-nav__burger {
      display: flex;
    }
  }
</style>

<script>
  (() => {
    class HeaderSmoky extends HTMLElement {
      connectedCallback() {
        this.burger = this.querySelector('.smoky-nav__burger');
        this.drawer = this.querySelector('.smoky-drawer');
        if (!this.burger || !this.drawer) return;
        this.burger.addEventListener('click', () => this.toggle());
        this.drawer.querySelector('.smoky-drawer__close')?.addEventListener('click', () => this.toggle(false));
        this.addEventListener('keyup', (e) => {
          if (e.key === 'Escape') this.toggle(false);
        });
        this.drawer.addEventListener('click', (e) => {
          if (e.target.closest('a')) this.toggle(false);
        });
      }

      toggle(force) {
        const open = force ?? this.burger.getAttribute('aria-expanded') !== 'true';
        this.burger.setAttribute('aria-expanded', open);
        document.documentElement.classList.toggle('smoky-drawer-open', open);
        clearTimeout(this.closeTimer);
        if (open) {
          this.drawer.hidden = false;
          // force a frame so the clip-path transition actually runs
          requestAnimationFrame(() => requestAnimationFrame(() => this.drawer.classList.add('is-open')));
        } else {
          this.drawer.classList.remove('is-open');
          this.closeTimer = setTimeout(() => (this.drawer.hidden = true), 700);
        }
      }
    }
    if (!customElements.get('header-smoky')) customElements.define('header-smoky', HeaderSmoky);
  })();
</script>

{% schema %}
{
  "name": "Smoky header",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Меню",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Максимална ширина",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1150
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Залепена навигация (sticky)",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Smoky header"
    }
  ]
}
{% endschema %}
