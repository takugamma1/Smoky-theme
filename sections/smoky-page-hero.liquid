{% comment %}
  Smoky page hero — inner-page header: small uppercase kicker, giant condensed
  title (static or infinitely scrolling marquee, the FTC about-page trick),
  optional lead text and photo panel below.
{% endcomment %}

<section class="smoky-phero smoky-grained{% if section.settings.curve_top %} smoky-curl-top{% endif %}{% if section.settings.curve_bottom %} smoky-curl-bottom{% endif %}" id="smoky-phero-{{ section.id }}">
  <div class="smoky-container">
    {%- if section.settings.kicker != blank -%}
      <p class="smoky-kicker smoky-phero__kicker" data-smoky-reveal>{{ section.settings.kicker }}</p>
    {%- endif -%}
  </div>

  {%- if section.settings.marquee -%}
    <div class="smoky-phero__marquee" data-smoky-marquee data-marquee-speed="80" data-marquee-direction="left">
      <div class="smoky-marquee-track">
        <h1 class="smoky-title smoky-title--big smoky-phero__title smoky-phero__title--marquee">{{ section.settings.title }}&nbsp;—&nbsp;</h1>
      </div>
    </div>
  {%- else -%}
    <div class="smoky-container">
      <h1 class="smoky-title smoky-title--big smoky-phero__title" data-smoky-reveal>{{ section.settings.title }}</h1>
    </div>
  {%- endif -%}

  {%- if section.settings.lead != blank -%}
    <div class="smoky-container">
      <p class="smoky-phero__lead" data-smoky-reveal data-smoky-reveal-delay="0.1">{{ section.settings.lead }}</p>
    </div>
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    <div class="smoky-container">
      <div class="smoky-phero__media" data-smoky-reveal data-smoky-reveal-delay="0.15">
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 1920, 2400', sizes: '92vw' }}
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  #smoky-phero-{{ section.id }} {
    background: var(--smoky-cream);
    color: var(--smoky-dark);
    padding-top: clamp(120px, 15vw, 190px);
    padding-bottom: clamp(28px, 4vw, 56px);
    overflow: clip;
  }

  #smoky-phero-{{ section.id }} .smoky-phero__kicker {
    margin: 0 0 0.8em;
    color: var(--smoky-pink);
  }

  #smoky-phero-{{ section.id }} .smoky-phero__title--marquee { white-space: nowrap; }

  #smoky-phero-{{ section.id }} .smoky-phero__lead {
    margin: clamp(16px, 2vw, 28px) 0 0;
    max-width: 34em;
    font-family: var(--smoky-font-body);
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    line-height: 1.5;
  }

  #smoky-phero-{{ section.id }} .smoky-phero__media {
    margin-top: clamp(24px, 3vw, 44px);
    border-radius: var(--smoky-radius-big);
    overflow: hidden;
    aspect-ratio: 16 / 7.5;
  }

  #smoky-phero-{{ section.id }} .smoky-phero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    #smoky-phero-{{ section.id }} { padding-top: 108px; }
    #smoky-phero-{{ section.id }} .smoky-phero__media { aspect-ratio: 4 / 3; }
  }
</style>

{% schema %}
{
  "name": "Smoky заглавие стр.",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Малък надпис отгоре"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Заглавие",
      "default": "ЗАГЛАВИЕ"
    },
    {
      "type": "checkbox",
      "id": "marquee",
      "label": "Заглавието се движи (маркии)",
      "default": false
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Водещ текст"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Снимка (по избор)"
    },
    {
      "type": "checkbox",
      "id": "curve_top",
      "label": "Заоблен горен ръб (над тъмно)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "curve_bottom",
      "label": "Заоблен долен ръб (над тъмно)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Smoky заглавие стр."
    }
  ]
}
{% endschema %}
