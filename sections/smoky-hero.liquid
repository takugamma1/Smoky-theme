{% comment %}
  Smoky hero — the "Let's change catering!" pattern in Smoky clothes.

  Line 1 of the giant condensed title sits on cream paper next to a looping
  word bubble (sand pill cycling greetings) with a round mascot sticker.
  Line 2 overlaps the rounded media panel below in a notched cream box with
  inverted corners. Media is a photo or a muted looping mp4 video.
{% endcomment %}

<section class="smoky-hero" id="smoky-hero-{{ section.id }}">
  <div class="smoky-container smoky-hero__container">
    <h1 class="visually-hidden">{{ section.settings.seo_title | default: 'Smoky — балканска скара с доставка' }}</h1>

    <div class="smoky-title smoky-title--big smoky-hero__title" aria-hidden="true">
      <div class="smoky-hero__line1" data-smoky-reveal>
        <span>{{ section.settings.line1 }}</span>
        {%- assign words = section.settings.loop_words | split: ',' -%}
        {%- if words.size > 0 -%}
          <span class="smoky-hero__bubble" data-smoky-loop-words>
            <span class="smoky-hero__bubble-words">
              {%- for word in words -%}
                <span class="smoky-loop-word">{{ word | strip }}</span>
              {%- endfor -%}
            </span>
            {%- if section.settings.sticker != blank or section.settings.use_mascot -%}
              <span class="smoky-hero__sticker" data-smoky-scrub-rotate="16">
                {%- if section.settings.sticker != blank -%}
                  {{ section.settings.sticker | image_url: width: 300 | image_tag: loading: 'eager', alt: '' }}
                {%- else -%}
                  <img src="{{ 'smoky-mascot-happy.svg' | asset_url }}" alt="" width="150" height="150">
                {%- endif -%}
              </span>
            {%- endif -%}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="smoky-hero__media-wrap" data-smoky-reveal data-smoky-reveal-delay="0.1">
      {%- if section.settings.show_flames -%}
        <div class="smoky-hero__flames" aria-hidden="true">
          <img src="{{ 'smoky-flame-sticker.svg' | asset_url }}" alt="" loading="eager" width="70" height="90" class="smoky-hero__flame smoky-hero__flame--1">
          <img src="{{ 'smoky-flame-sticker.svg' | asset_url }}" alt="" loading="eager" width="70" height="90" class="smoky-hero__flame smoky-hero__flame--2">
          <img src="{{ 'smoky-flame-sticker.svg' | asset_url }}" alt="" loading="eager" width="70" height="90" class="smoky-hero__flame smoky-hero__flame--3">
        </div>
      {%- endif -%}
      <div class="smoky-hero__media">
        {%- if section.settings.video_url != blank -%}
          <video autoplay muted loop playsinline preload="metadata" {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1920 }}"{% endif %}>
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {%- elsif section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400', sizes: '92vw' }}
        {%- else -%}
          <div class="smoky-hero__media-placeholder">
            <img src="{{ 'smoky-wordmark-sand.svg' | asset_url }}" alt="" loading="eager" width="600" height="200">
          </div>
        {%- endif -%}
      </div>

      <div class="smoky-hero__h1box" aria-hidden="true">
        <span class="smoky-hero__corner smoky-hero__corner--left"></span>
        <span class="smoky-hero__corner smoky-hero__corner--bottom"></span>
        <span class="smoky-title smoky-title--big smoky-hero__line2">{{ section.settings.line2 }}</span>
        {%- if section.settings.show_flames -%}
          <img src="{{ 'smoky-flame-sticker.svg' | asset_url }}" alt="" loading="eager" width="70" height="90" class="smoky-hero__flame smoky-hero__flame--title" aria-hidden="true">
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
      <div class="smoky-hero__actions" data-smoky-reveal data-smoky-reveal-delay="0.2">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="smoky-btn">
            <span class="smoky-btn__shadow"></span>
            <span class="smoky-btn__content">
              <span class="smoky-roll"><span>{{ section.settings.button_label }}</span><span class="smoky-roll__dup">{{ section.settings.button_label }}</span></span>
            </span>
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_link | default: '#' }}" class="smoky-btn smoky-btn--light">
            <span class="smoky-btn__shadow"></span>
            <span class="smoky-btn__content">
              <span class="smoky-roll"><span>{{ section.settings.button2_label }}</span><span class="smoky-roll__dup">{{ section.settings.button2_label }}</span></span>
            </span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #smoky-hero-{{ section.id }} {
    background: var(--smoky-cream);
    color: var(--smoky-dark);
    padding-top: clamp(120px, 15vw, 190px);
    padding-bottom: clamp(32px, 4vw, 64px);
    overflow: clip;
  }

  #smoky-hero-{{ section.id }} .smoky-hero__line1 {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: clamp(16px, 2vw, 32px);
    color: var(--smoky-dark);
    /* own fluid scale so line1 + bubble always fit on one row above mobile */
    font-size: clamp(2.4rem, 6.2vw, 8.6rem);
    white-space: nowrap;
  }

  /* looping greeting bubble — fixed-scale, independent from the giant title em */
  /* the greeting pill: bordered + hard offset shadow, mascot hanging off its edge */
  #smoky-hero-{{ section.id }} .smoky-hero__bubble {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: 0 1 auto;
    min-width: 0;
    height: clamp(52px, 5.8vw, 88px);
    margin-right: clamp(44px, 4.2vw, 72px);
    padding: 0 clamp(48px, 4.4vw, 76px) 0 clamp(22px, 2.2vw, 40px);
    border: var(--smoky-border);
    border-radius: 999px;
    background: var(--smoky-sand);
    box-shadow: 0 0.28em 0 rgb(40 40 40 / 0.28);
    transition: transform var(--smoky-anim-bounce);
  }

  #smoky-hero-{{ section.id }} .smoky-hero__bubble:hover { transform: translateY(-0.18em) rotate(-1.5deg); }

  #smoky-hero-{{ section.id }} .smoky-hero__bubble-words {
    position: relative;
    display: block;
    overflow: hidden;
    min-width: 9em;
    height: 1.5em;
    font-family: var(--smoky-font-body);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    line-height: 1.5;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  #smoky-hero-{{ section.id }} .smoky-loop-word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transform: translateY(110%);
    transition: transform 0.6s var(--smoky-bounce);
  }

  /* first word visible before JS wires the loop */
  #smoky-hero-{{ section.id }} .smoky-loop-word:first-child { transform: translateY(0); }
  #smoky-hero-{{ section.id }} .smoky-loop-word[data-word-status='next'] { transform: translateY(110%); }
  #smoky-hero-{{ section.id }} .smoky-loop-word[data-word-status='active'] { transform: translateY(0); }
  #smoky-hero-{{ section.id }} .smoky-loop-word[data-word-status='prev'] { transform: translateY(-110%); }

  /* Димо floats free off the pill edge — no circle backer */
  #smoky-hero-{{ section.id }} .smoky-hero__sticker {
    position: absolute;
    right: clamp(-52px, -3.6vw, -34px);
    top: 50%;
    width: clamp(76px, 8vw, 122px);
    height: clamp(76px, 8vw, 122px);
    margin-top: calc(clamp(76px, 8vw, 122px) / -2 - 0.35em);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    filter: drop-shadow(0 6px 8px rgb(40 40 40 / 0.32));
    pointer-events: none;
  }

  #smoky-hero-{{ section.id }} .smoky-hero__sticker img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* media panel with notched title box */
  #smoky-hero-{{ section.id }} .smoky-hero__media-wrap {
    position: relative;
    margin-top: clamp(14px, 1.6vw, 26px);
  }

  #smoky-hero-{{ section.id }} .smoky-hero__media {
    position: relative;
    z-index: 1;
    border-radius: var(--smoky-radius-big);
    overflow: hidden;
    background: var(--smoky-dark-soft);
    aspect-ratio: 16 / 8.2;
  }

  /* flames peeking from behind the media panel */
  #smoky-hero-{{ section.id }} .smoky-hero__flames {
    position: absolute;
    top: 4px;
    left: clamp(24px, 6vw, 90px);
    display: flex;
    align-items: flex-end;
    gap: clamp(6px, 1vw, 14px);
    z-index: 0;
  }

  #smoky-hero-{{ section.id }} .smoky-hero__flame {
    display: block;
    width: clamp(34px, 4vw, 62px);
    height: auto;
    transform-origin: 50% 100%;
  }

  #smoky-hero-{{ section.id }} .smoky-hero__flame--1 { transform: translateY(-62%) rotate(-6deg); }
  #smoky-hero-{{ section.id }} .smoky-hero__flame--2 { width: clamp(46px, 5.4vw, 84px); transform: translateY(-70%); }
  #smoky-hero-{{ section.id }} .smoky-hero__flame--3 { transform: translateY(-58%) rotate(7deg); }

  #smoky-hero-{{ section.id }} .smoky-hero__flame--title {
    position: absolute;
    top: calc(clamp(26px, 2.8vw, 44px) * -0.72);
    right: clamp(-14px, -1vw, -6px);
    width: clamp(26px, 2.8vw, 44px);
    transform: rotate(10deg);
    transform-origin: 50% 100%;
    z-index: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    #smoky-hero-{{ section.id }} .smoky-hero__flame { animation: smoky-flicker-{{ section.id }} 1.7s ease-in-out infinite alternate; }
    #smoky-hero-{{ section.id }} .smoky-hero__flame--1 { animation-duration: 1.5s; animation-delay: 0.2s; --flame-rot: -6deg; --flame-y: -62%; }
    #smoky-hero-{{ section.id }} .smoky-hero__flame--2 { animation-duration: 1.9s; --flame-rot: 0deg; --flame-y: -70%; }
    #smoky-hero-{{ section.id }} .smoky-hero__flame--3 { animation-duration: 1.4s; animation-delay: 0.45s; --flame-rot: 7deg; --flame-y: -58%; }
    #smoky-hero-{{ section.id }} .smoky-hero__flame--title { animation-duration: 1.6s; animation-delay: 0.1s; --flame-rot: 8deg; --flame-y: 0%; }
  }

  @keyframes smoky-flicker-{{ section.id }} {
    0% { transform: translateY(var(--flame-y, 0%)) rotate(var(--flame-rot, 0deg)) scaleY(1) scaleX(1); }
    45% { transform: translateY(var(--flame-y, 0%)) rotate(calc(var(--flame-rot, 0deg) + 3deg)) scaleY(1.1) scaleX(0.94); }
    100% { transform: translateY(var(--flame-y, 0%)) rotate(calc(var(--flame-rot, 0deg) - 2deg)) scaleY(0.94) scaleX(1.04); }
  }

  #smoky-hero-{{ section.id }} .smoky-hero__media img,
  #smoky-hero-{{ section.id }} .smoky-hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #smoky-hero-{{ section.id }} .smoky-hero__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #smoky-hero-{{ section.id }} .smoky-hero__media-placeholder img {
    width: 46%;
    height: auto;
    object-fit: contain;
    opacity: 0.85;
  }

  #smoky-hero-{{ section.id }} .smoky-hero__h1box {
    position: absolute;
    right: 0;
    top: 0;
    z-index: 2;
    padding: 0 0 clamp(10px, 1.4vw, 22px) clamp(14px, 2vw, 30px);
    background: var(--smoky-cream);
    border-radius: 0 0 0 var(--smoky-radius-big);
    line-height: 0;
  }

  #smoky-hero-{{ section.id }} .smoky-hero__line2 {
    color: var(--smoky-dark);
    line-height: 0.85;
  }

  /* inverted corners melting the box into the rounded media frame */
  #smoky-hero-{{ section.id }} .smoky-hero__corner {
    position: absolute;
    width: var(--smoky-radius-big);
    height: var(--smoky-radius-big);
    background: radial-gradient(circle at 0 100%, transparent calc(var(--smoky-radius-big) - 1px), var(--smoky-cream) var(--smoky-radius-big));
  }

  #smoky-hero-{{ section.id }} .smoky-hero__corner--left {
    top: 0;
    left: calc(-1 * var(--smoky-radius-big) + 1px);
  }

  #smoky-hero-{{ section.id }} .smoky-hero__corner--bottom {
    right: 0;
    bottom: calc(-1 * var(--smoky-radius-big) + 1px);
  }

  #smoky-hero-{{ section.id }} .smoky-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(20px, 2.6vw, 36px);
  }

  @media screen and (max-width: 749px) {
    #smoky-hero-{{ section.id }} { padding-top: 108px; }

    #smoky-hero-{{ section.id }} .smoky-hero__media { aspect-ratio: 4 / 5; }

    #smoky-hero-{{ section.id }} .smoky-hero__line1 { flex-wrap: wrap; row-gap: 14px; white-space: normal; }

    #smoky-hero-{{ section.id }} .smoky-hero__line1 > span:first-child { white-space: nowrap; }

    #smoky-hero-{{ section.id }} .smoky-hero__bubble-words { min-width: 7.5em; }

    #smoky-hero-{{ section.id }} .smoky-hero__h1box {
      position: static;
      padding: 12px 0 0;
      border-radius: 0;
      background: none;
    }

    #smoky-hero-{{ section.id }} .smoky-hero__corner { display: none; }

    #smoky-hero-{{ section.id }} .smoky-hero__flame--title { display: none; }

    #smoky-hero-{{ section.id }} .smoky-hero__media-wrap {
      display: flex;
      flex-direction: column-reverse;
    }
  }
</style>

{% schema %}
{
  "name": "Smoky херо",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "seo_title", "label": "SEO заглавие (скрито)", "default": "Smoky — балканска скара с доставка" },
    { "type": "text", "id": "line1", "label": "Заглавие — ред 1", "default": "ДА ЗАПАЛИМ" },
    { "type": "text", "id": "line2", "label": "Заглавие — ред 2", "default": "СКАРАТА!" },
    { "type": "text", "id": "loop_words", "label": "Въртящи се думи (със запетая)", "default": "Добър апетит!, На жар!, Bon appétit!, Смак!, Наздраве!" },
    { "type": "checkbox", "id": "use_mascot", "label": "Стикер с Димо до балончето", "default": true },
    { "type": "checkbox", "id": "show_flames", "label": "Пламъци около медията", "default": true },
    { "type": "image_picker", "id": "sticker", "label": "Собствен стикер (по избор)" },
    { "type": "image_picker", "id": "image", "label": "Снимка" },
    { "type": "url", "id": "video_url", "label": "Видео (mp4 URL, по избор)" },
    { "type": "text", "id": "button_label", "label": "Бутон 1 — текст", "default": "Поръчай сега" },
    { "type": "url", "id": "button_link", "label": "Бутон 1 — линк" },
    { "type": "text", "id": "button2_label", "label": "Бутон 2 — текст", "default": "Виж менюто" },
    { "type": "url", "id": "button2_link", "label": "Бутон 2 — линк" }
  ],
  "presets": [{ "name": "Smoky херо" }]
}
{% endschema %}
