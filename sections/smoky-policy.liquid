{% comment %}
  Smoky policy / prose — styled legal & long-form text on cream paper:
  dateline, big condensed title, then richtext chapter blocks (subheading +
  body) inside a comfortable reading column. Content lives in the template
  JSON, so the whole policy ships with the theme.
{% endcomment %}

<section class="smoky-policy" id="smoky-policy-{{ section.id }}">
  <div class="smoky-container smoky-container--small">
    {%- if section.settings.updated != blank -%}
      <p class="smoky-kicker smoky-policy__updated">{{ section.settings.updated }}</p>
    {%- endif -%}
    <h1 class="smoky-title smoky-title--main smoky-policy__title">{{ section.settings.title }}</h1>

    <div class="smoky-policy__content">
      {%- for block in section.blocks -%}
        <div class="smoky-policy__chapter" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}
          <div class="smoky-policy__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 and page.content != blank -%}
        <div class="smoky-policy__text">{{ page.content }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #smoky-policy-{{ section.id }} {
    background: var(--smoky-cream);
    color: var(--smoky-dark);
    padding-top: clamp(120px, 15vw, 190px);
    padding-bottom: clamp(64px, 8vw, 120px);
  }

  #smoky-policy-{{ section.id }} .smoky-policy__updated {
    margin: 0 0 0.9em;
    color: var(--smoky-pink);
  }

  #smoky-policy-{{ section.id }} .smoky-policy__title { margin-bottom: clamp(32px, 4.5vw, 56px); }

  #smoky-policy-{{ section.id }} .smoky-policy__chapter { margin-bottom: clamp(28px, 3.4vw, 44px); }

  #smoky-policy-{{ section.id }} .smoky-policy__chapter h2 {
    margin: 0 0 0.6em;
    font-family: var(--smoky-font-heading);
    font-weight: 700;
    font-size: clamp(1.3rem, 1.8vw, 1.7rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  #smoky-policy-{{ section.id }} .smoky-policy__text {
    font-family: var(--smoky-font-body);
    font-size: clamp(0.98rem, 1.15vw, 1.1rem);
    line-height: 1.65;
  }

  #smoky-policy-{{ section.id }} .smoky-policy__text p { margin: 0 0 1em; }
  #smoky-policy-{{ section.id }} .smoky-policy__text ul { margin: 0 0 1em; padding-left: 1.3em; }
  #smoky-policy-{{ section.id }} .smoky-policy__text li { margin-bottom: 0.4em; }
  #smoky-policy-{{ section.id }} .smoky-policy__text a { color: var(--smoky-pink); }
  #smoky-policy-{{ section.id }} .smoky-policy__text strong { font-weight: 600; }

  @media screen and (max-width: 749px) {
    #smoky-policy-{{ section.id }} { padding-top: 108px; }
  }
</style>

{% schema %}
{
  "name": "Smoky правен текст",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "updated", "label": "Дата на актуализация", "default": "Актуализирано на 24 август 2026 г." },
    { "type": "text", "id": "title", "label": "Заглавие", "default": "ОБЩИ УСЛОВИЯ" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Раздел",
      "settings": [
        { "type": "text", "id": "heading", "label": "Заглавие на раздела" },
        { "type": "richtext", "id": "text", "label": "Текст", "default": "<p>Текст на раздела.</p>" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "Smoky правен текст" }]
}
{% endschema %}
