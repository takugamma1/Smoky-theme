{% comment %}
  Smoky 404 — "nothing to eat here": giant 404, sad Димо sticker, a short
  line and two ways out (home / menu) on a dotted-frame sand card.
{%- endcomment %}

<section class="smoky-404 smoky-grained smoky-curl-bottom" id="smoky-404-{{ section.id }}">
  <div class="smoky-container smoky-container--small">
    <div class="smoky-404__card" data-smoky-reveal>
      <svg class="smoky-dotted-frame" aria-hidden="true" preserveAspectRatio="none">
        <rect style="x:1px;y:1px;width:calc(100% - 2px);height:calc(100% - 2px)" rx="24" stroke="var(--smoky-pink)"></rect>
      </svg>
      <span class="smoky-404__mascot" aria-hidden="true">
        <img src="{{ 'smoky-mascot-sad.svg' | asset_url }}" alt="" width="160" height="160" loading="eager">
      </span>
      <p class="smoky-404__code" aria-hidden="true">404</p>
      <h1 class="smoky-title smoky-title--small smoky-404__title">{{ section.settings.heading }}</h1>
      <p class="smoky-404__text">{{ section.settings.text }}</p>
      <div class="smoky-404__actions">
        <a href="{{ routes.root_url }}" class="smoky-btn">
          <span class="smoky-btn__shadow"></span>
          <span class="smoky-btn__content"><span class="smoky-roll"><span>{{ section.settings.home_label }}</span><span class="smoky-roll__dup">{{ section.settings.home_label }}</span></span></span>
        </a>
        <a href="{% render 'smoky-url', link: section.settings.menu_link, kind: 'menu' %}" class="smoky-btn smoky-btn--dark">
          <span class="smoky-btn__shadow"></span>
          <span class="smoky-btn__content"><span class="smoky-roll"><span>{{ section.settings.menu_label }}</span><span class="smoky-roll__dup">{{ section.settings.menu_label }}</span></span></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  #smoky-404-{{ section.id }} {
    background: var(--smoky-cream);
    color: var(--smoky-dark);
    padding: clamp(140px, 18vw, 220px) 0 clamp(80px, 10vw, 140px);
  }

  #smoky-404-{{ section.id }} .smoky-404__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(10px, 1.4vw, 18px);
    padding: clamp(72px, 8vw, 110px) clamp(24px, 4vw, 56px) clamp(36px, 4vw, 56px);
    background: var(--smoky-sand);
    border: var(--smoky-border);
    border-radius: var(--smoky-radius);
    box-shadow: 0 0.45em 0 var(--smoky-shadow-color);
  }

  #smoky-404-{{ section.id }} .smoky-404__mascot {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(120px, 14vw, 190px);
    transform: translate(-50%, -52%) rotate(-6deg);
    filter: drop-shadow(0 8px 12px rgb(40 40 40 / 0.3));
  }

  #smoky-404-{{ section.id }} .smoky-404__mascot img { width: 100%; height: auto; display: block; }

  #smoky-404-{{ section.id }} .smoky-404__code {
    margin: 0;
    font-family: var(--smoky-font-heading);
    font-weight: 800;
    font-size: clamp(5rem, 14vw, 12rem);
    line-height: 0.85;
    color: var(--smoky-pink);
    letter-spacing: -0.02em;
  }

  #smoky-404-{{ section.id }} .smoky-404__title { max-width: 14em; }

  #smoky-404-{{ section.id }} .smoky-404__text {
    margin: 0;
    max-width: 38ch;
    font-family: var(--smoky-font-body);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.55;
  }

  #smoky-404-{{ section.id }} .smoky-404__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: clamp(14px, 1.8vw, 24px);
  }
</style>

{% schema %}
{
  "name": "Smoky 404",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заглавие", "default": "ТУК НЯМА НИЩО ЗА ЯДЕНЕ" },
    { "type": "textarea", "id": "text", "label": "Текст", "default": "Страницата или е изгоряла на жарта, или никога не е съществувала. Върни се на началото или направо към менюто — там винаги има нещо горещо." },
    { "type": "text", "id": "home_label", "label": "Бутон — начало", "default": "Към началото" },
    { "type": "text", "id": "menu_label", "label": "Бутон — меню", "default": "Виж менюто" },
    { "type": "url", "id": "menu_link", "label": "Линк към менюто (по избор — иначе автоматично)" }
  ]
}
{% endschema %}
