{% comment %}
  Smoky concepts slider — the FTC foodtruck-card carousel as a menu-category
  slider. Each block is a colored tile with its own bg/border colors (inline
  CSS custom properties), a dashed ring circle behind a cutout dish image,
  and a "Виж" pill. Native scroll-snap drag + round arrows + drag cursor.
{% endcomment %}

<section class="smoky-concepts smoky-grained--light" id="smoky-concepts-{{ section.id }}">
  <div class="smoky-container">
    <h2 class="smoky-title smoky-title--small smoky-concepts__heading" data-smoky-reveal>
      {{ section.settings.heading_before }}
      <span class="smoky-accent">{{ section.settings.heading_accent }}</span>
      {{ section.settings.heading_after }}
    </h2>
  </div>

  <div class="smoky-concepts__viewport" data-smoky-drag-cursor tabindex="0" aria-label="{{ section.settings.heading_accent | escape }}">
    <ul class="smoky-concepts__track">
      {%- for block in section.blocks -%}
        {%- liquid
          # product photo resolution: manual cutout PNG > product > collection's first product > collection image
          assign card_img = blank
          assign img_style = 'photo'
          if block.settings.image != blank
            assign card_img = block.settings.image
            assign img_style = 'cutout'
          elsif block.settings.product != blank and block.settings.product.featured_image != blank
            assign card_img = block.settings.product.featured_image
          elsif block.settings.collection != blank
            for product in block.settings.collection.products limit: 4
              if product.featured_image != blank
                assign card_img = product.featured_image
                break
              endif
            endfor
            if card_img == blank and block.settings.collection.featured_image != blank
              assign card_img = block.settings.collection.featured_image
            endif
          endif

          assign card_url = block.settings.link
          if card_url == blank and block.settings.collection != blank
            assign card_url = block.settings.collection.url
          endif
          if card_url == blank and block.settings.product != blank
            assign card_url = block.settings.product.url
          endif

          assign card_title = block.settings.title
          if card_title == blank and block.settings.collection != blank
            assign card_title = block.settings.collection.title
          endif
        -%}
        <li
          class="smoky-concepts__card"
          style="--tile-bg: {{ block.settings.tile_bg }}; --tile-border: {{ block.settings.tile_border }};"
          {{ block.shopify_attributes }}
        >
          {%- if card_url != blank -%}
            <a href="{{ card_url }}" class="smoky-concepts__link" aria-label="{{ card_title | escape }}"></a>
          {%- endif -%}
          <div class="smoky-concepts__circle" aria-hidden="true">
            <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
              <circle cx="200" cy="200" r="150" fill="var(--tile-border)"></circle>
              <circle class="smoky-concepts__ring" cx="200" cy="200" r="178" fill="none" stroke="var(--tile-border)" stroke-width="2.5" stroke-dasharray="7 7"></circle>
            </svg>
            {%- if card_img != blank -%}
              {%- assign img_class = 'smoky-concepts__img smoky-concepts__img--is-' | append: img_style -%}
              {{ card_img | image_url: width: 700 | image_tag: loading: 'lazy', alt: card_title, class: img_class }}
            {%- else -%}
              <img src="{{ 'smoky-mascot-front.svg' | asset_url }}" alt="" loading="lazy" width="300" height="300" class="smoky-concepts__img smoky-concepts__img--placeholder">
            {%- endif -%}
          </div>
          <h3 class="smoky-concepts__title">{{ card_title }}</h3>
          {%- if block.settings.subtitle != blank -%}
            <p class="smoky-concepts__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <span class="smoky-btn smoky-btn--light smoky-concepts__btn" aria-hidden="true">
              <span class="smoky-btn__shadow"></span>
              <span class="smoky-btn__content">{{ section.settings.card_button_label }}</span>
            </span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="smoky-container smoky-concepts__controls">
    <button type="button" class="smoky-arrow smoky-arrow--prev" data-dir="-1" aria-label="Назад">
      <span class="smoky-arrow__shadow"></span>
      <span class="smoky-arrow__fill">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </button>
    <button type="button" class="smoky-arrow" data-dir="1" aria-label="Напред">
      <span class="smoky-arrow__shadow"></span>
      <span class="smoky-arrow__fill">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </button>
  </div>
</section>

<style>
  #smoky-concepts-{{ section.id }} {
    background: var(--smoky-dark-soft);
    color: var(--smoky-sand);
    padding-block: clamp(64px, 9vw, 130px);
    overflow: clip;
    {% if section.settings.curve_top %}border-top-left-radius: var(--smoky-radius-big); border-top-right-radius: var(--smoky-radius-big);{% endif %}
    {% if section.settings.curve_bottom %}border-bottom-left-radius: var(--smoky-radius-big); border-bottom-right-radius: var(--smoky-radius-big);{% endif %}
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__heading {
    color: var(--smoky-sand);
    max-width: 14em;
    margin-bottom: clamp(28px, 4vw, 56px);
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__viewport::-webkit-scrollbar { display: none; }

  #smoky-concepts-{{ section.id }} .smoky-concepts__track {
    display: flex;
    gap: clamp(18px, 2.2vw, 32px);
    list-style: none;
    margin: 0;
    padding: 10px min(8vw, 96px) 10px;
    width: max-content;
  }

  /* arch card on black paper material (best-sellers recipe) */
  #smoky-concepts-{{ section.id }} .smoky-concepts__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: clamp(270px, 26vw, 380px);
    padding: clamp(44px, 4.5vw, 68px) clamp(18px, 2vw, 28px) clamp(26px, 2.6vw, 38px);
    border: 9px solid var(--smoky-sand);
    border-radius: 999px 999px 22px 22px;
    background-color: #232221;
    background-image:
      radial-gradient(90% 60% at 50% 18%, color-mix(in srgb, var(--tile-bg) 55%, transparent), transparent 70%),
      radial-gradient(120% 90% at 25% 12%, rgb(255 255 255 / 0.07), transparent 55%),
      linear-gradient(155deg, transparent 30%, rgb(0 0 0 / 0.35) 78%),
      var(--smoky-grain);
    background-size: auto, auto, auto, 220px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
    scroll-snap-align: center;
    transition: transform var(--smoky-anim-bounce);
    overflow: hidden;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__card:hover { transform: translateY(-8px); }

  #smoky-concepts-{{ section.id }} .smoky-concepts__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__circle {
    position: relative;
    width: 100%;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__circle svg {
    width: 100%;
    height: auto;
    display: block;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__ring {
    transform-origin: 50% 50%;
    transition: transform 0.6s var(--smoky-bounce);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 0.4 16;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__card:hover .smoky-concepts__ring { transform: rotate(-14deg); }

  #smoky-concepts-{{ section.id }} .smoky-concepts__img {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
    object-fit: contain;
    filter: drop-shadow(0 16px 20px rgb(0 0 0 / 0.35));
    transition: transform 0.5s var(--smoky-bounce);
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__card:hover .smoky-concepts__img {
    transform: scale(1.06) rotate(-4deg);
  }

  /* real product photo: round medallion clipped onto the solid circle */
  #smoky-concepts-{{ section.id }} .smoky-concepts__img--is-photo {
    inset: 13%;
    width: 74%;
    height: 74%;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--tile-border);
    filter: none;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__img--placeholder { inset: 20%; width: 60%; height: 60%; }

  #smoky-concepts-{{ section.id }} .smoky-concepts__title {
    margin: clamp(14px, 1.6vw, 22px) 0 0;
    font-family: var(--smoky-font-heading);
    font-weight: 800;
    font-size: clamp(1.5rem, 2vw, 2rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--tile-border);
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__subtitle {
    margin: 6px 0 0;
    font-family: var(--smoky-font-body);
    font-size: clamp(0.9rem, 1vw, 1rem);
    color: var(--smoky-sand);
    opacity: 0.85;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__btn {
    margin-top: clamp(16px, 1.8vw, 24px);
    font-size: 0.85rem;
  }

  #smoky-concepts-{{ section.id }} .smoky-concepts__controls {
    display: flex;
    gap: 14px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  @media screen and (max-width: 749px) {
    #smoky-concepts-{{ section.id }} .smoky-concepts__card { width: 78vw; }
    #smoky-concepts-{{ section.id }} .smoky-concepts__track { padding-inline: 5vw; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('smoky-concepts-{{ section.id }}');
    if (!root) return;
    const viewport = root.querySelector('.smoky-concepts__viewport');
    const card = root.querySelector('.smoky-concepts__card');
    root.querySelectorAll('.smoky-arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = (card ? card.offsetWidth + 24 : 320) * parseInt(btn.dataset.dir, 10);
        viewport.scrollBy({ left: step, behavior: 'smooth' });
      });
    });

    // drag to scroll with the mouse (touch scrolls natively)
    let down = false, startX = 0, startScroll = 0;
    viewport.addEventListener('mousedown', (e) => {
      down = true;
      startX = e.pageX;
      startScroll = viewport.scrollLeft;
      viewport.style.cursor = 'grabbing';
      viewport.style.scrollSnapType = 'none';
    });
    window.addEventListener('mouseup', () => {
      if (!down) return;
      down = false;
      viewport.style.cursor = 'grab';
      viewport.style.scrollSnapType = '';
    });
    window.addEventListener('mousemove', (e) => {
      if (!down) return;
      e.preventDefault();
      viewport.scrollLeft = startScroll - (e.pageX - startX);
    });
    viewport.addEventListener('click', (e) => {
      if (Math.abs(viewport.scrollLeft - startScroll) > 8) e.preventDefault();
    }, true);
  })();
</script>

{% schema %}
{
  "name": "Smoky категории слайдер",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_before",
      "label": "Заглавие — начало",
      "default": "Нашите"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Заглавие — акцент (розово)",
      "default": "вкусове"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Заглавие — край",
      "default": "от скарата"
    },
    {
      "type": "text",
      "id": "card_button_label",
      "label": "Бутон на картите",
      "default": "Виж"
    },
    {
      "type": "checkbox",
      "id": "curve_top",
      "label": "Заоблен горен ръб",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "curve_bottom",
      "label": "Заоблен долен ръб",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Карта",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Колекция (снимка + линк)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Продукт за снимката (по избор)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Име",
          "default": "Кебапчета"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Подзаглавие"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Изрязана снимка PNG (override)"
        },
        {
          "type": "color",
          "id": "tile_bg",
          "label": "Фон на картата",
          "default": "#3A2E2A"
        },
        {
          "type": "color",
          "id": "tile_border",
          "label": "Рамка и акцент",
          "default": "#EBDCC3"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Линк"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Smoky категории слайдер",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Кебапчета",
            "tile_bg": "#4A1230",
            "tile_border": "#FA0082"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Кюфтета",
            "tile_bg": "#3A2E2A",
            "tile_border": "#EBDCC3"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Стекове",
            "tile_bg": "#301B14",
            "tile_border": "#E8956B"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Пилешко",
            "tile_bg": "#3F3A1E",
            "tile_border": "#E4D96F"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Сач",
            "tile_bg": "#1F3328",
            "tile_border": "#9BC49A"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Гарнитури",
            "tile_bg": "#403014",
            "tile_border": "#EFC069"
          }
        }
      ]
    }
  ]
}
{% endschema %}
