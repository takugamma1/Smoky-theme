{%- doc -%}
  Cart drawer, under the items: what the customer chose in the "Доставка или вземане?" bubble
  (snippets/smoky-order-type.liquid) with a "Промени" that reopens it, and the optional note.
  The address is NOT typed here any more — it is picked in the bubble before the menu.
  Behaviour: assets/smoky-cart-delivery.js.

  The element opts out of drawer morphing (data-skip-subtree-update): its state is owned by
  the script, a cart update must never wipe a note the customer is typing.
{%- enddoc -%}

<smoky-cart-delivery
  class="smoky-dlv"
  data-skip-subtree-update
  data-note="{{ cart.note | escape }}"
>
  <button type="button" class="smoky-dlv__choice is-empty" data-ot-open data-dlv-choice>
    <span class="smoky-dlv__choice-icon" aria-hidden="true">
      <svg data-dlv-icon="delivery" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="2.5"/><circle cx="18" cy="17" r="2.5"/><path d="M8.5 17h7M15.5 17l-2-9h-2.2M13 8h3.2l2 4.5M4 12h5.5l1.2 5"/></svg>
      <svg data-dlv-icon="pickup" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden><path d="M5.5 8.5h13l-1 11.5h-11z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/></svg>
    </span>
    <span class="smoky-dlv__choice-text">
      <strong data-dlv-choice-title>{{ 'smoky.order.q_title' | t }}</strong>
      <span data-dlv-choice-sub hidden></span>
    </span>
    <span class="smoky-dlv__change" data-dlv-change hidden>{{ 'smoky.order.change' | t }}</span>
  </button>

  <div class="smoky-dlv__note">
    <button type="button" class="smoky-dlv__note-toggle" data-dlv-note-toggle aria-expanded="false" aria-controls="smoky-dlv-note">
      <span class="smoky-dlv__note-plus" aria-hidden="true"></span>
      <span>{{ 'smoky.delivery.note_toggle' | t }}</span>
      <small>({{ 'smoky.delivery.optional' | t }})</small>
    </button>
    <textarea
      id="smoky-dlv-note"
      class="smoky-dlv__input smoky-dlv__textarea"
      name="smoky-dlv-note"
      rows="2"
      maxlength="300"
      placeholder="{{ 'smoky.delivery.note_placeholder' | t }}"
      aria-label="{{ 'smoky.delivery.note_toggle' | t }}"
      data-dlv-note
      data-skip-node-update
      hidden
    ></textarea>
  </div>

  <p class="smoky-dlv__error" data-dlv-error="save" role="alert" hidden></p>
</smoky-cart-delivery>

{% stylesheet %}
  .smoky-dlv {
    display: block;
    flex-shrink: 0;
    padding: 4px var(--cart-drawer-padding, 20px) 18px;
    color: var(--smoky-dark);
  }

  /* Horizon lets the item list shrink and scroll on its own; with this block under it the list
     collapsed to a sliver on short screens. Items + this block scroll together instead, the
     totals and the checkout button stay pinned at the bottom. */
  #cart-drawer .cart-drawer__items {
    flex-shrink: 0;
    overflow: visible;
  }

  /* the choice: a white card that says where the food goes and reopens the bubble */
  .smoky-dlv__choice {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 58px;
    padding: 9px 14px 9px 9px;
    border: var(--smoky-border);
    border-radius: 20px;
    background: #fff;
    color: var(--smoky-dark);
    box-shadow: 0 4px 0 var(--smoky-shadow-color);
    text-align: left;
    cursor: pointer;
    transition: transform var(--smoky-anim-bounce);
  }

  .smoky-dlv__choice:hover { transform: translateY(-2px); }

  .smoky-dlv__choice-icon {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: var(--smoky-border);
    border-radius: 50%;
    background: var(--smoky-pink);
    color: var(--smoky-cream);
  }

  .smoky-dlv__choice-icon svg { width: 22px; height: 22px; }
  .smoky-dlv__choice-icon svg[hidden] { display: none; }

  .smoky-dlv__choice-text { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }

  .smoky-dlv__choice-text strong {
    font-family: var(--smoky-font-heading);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .smoky-dlv__choice-text span {
    font-family: var(--smoky-font-body);
    font-size: 0.86rem;
    line-height: 1.2;
    color: rgb(40 40 40 / 0.7);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .smoky-dlv__choice-text span[hidden],
  .smoky-dlv__change[hidden] { display: none; }

  .smoky-dlv__change {
    flex: 0 0 auto;
    color: var(--smoky-pink);
    font-family: var(--smoky-font-heading);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* nothing chosen yet: the card becomes the call to action */
  .smoky-dlv__choice.is-empty {
    background: var(--smoky-pink);
    color: var(--smoky-cream);
    animation: smoky-dlv-pulse 1.8s ease-in-out infinite;
  }

  .smoky-dlv__choice.is-empty .smoky-dlv__choice-icon { background: var(--smoky-cream); color: var(--smoky-dark); }

  @keyframes smoky-dlv-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.025); }
  }

  /* note */
  .smoky-dlv__note { margin-top: 12px; }

  .smoky-dlv__note-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 4px 8px 4px 2px;
    border: 0;
    background: none;
    color: var(--smoky-dark);
    font-family: var(--smoky-font-heading);
    font-weight: 600;
    font-size: 0.86rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .smoky-dlv__note-toggle small { font-size: 0.74rem; font-weight: 500; opacity: 0.6; }

  .smoky-dlv__note-plus {
    position: relative;
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    border: var(--smoky-border);
    border-radius: 50%;
    background: var(--smoky-pink-soft);
  }

  .smoky-dlv__note-plus::before,
  .smoky-dlv__note-plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 2px;
    margin: -1px 0 0 -5px;
    background: var(--smoky-dark);
    transition: transform 0.2s ease;
  }

  .smoky-dlv__note-plus::after { transform: rotate(90deg); }
  .smoky-dlv__note-toggle[aria-expanded='true'] .smoky-dlv__note-plus::after { transform: rotate(0deg); }

  /* id-level specificity: Horizon paints every text field with its own light background */
  #cart-drawer .smoky-dlv__textarea,
  .smoky-dlv .smoky-dlv__textarea {
    display: block;
    width: 100%;
    min-height: 76px;
    margin: 8px 0 0;
    padding: 12px 18px;
    border: var(--smoky-border);
    border-radius: 20px;
    background: #fff;
    color: var(--smoky-dark);
    font-family: var(--smoky-font-body);
    font-size: 16px; /* 16px keeps iOS from zooming the page on focus */
    font-weight: 500;
    line-height: 1.3;
    box-shadow: none;
    outline: none;
    resize: vertical;
  }

  #cart-drawer .smoky-dlv__textarea::placeholder,
  .smoky-dlv .smoky-dlv__textarea::placeholder { color: rgb(40 40 40 / 0.45); }

  #cart-drawer .smoky-dlv__textarea:focus-visible,
  .smoky-dlv .smoky-dlv__textarea:focus-visible { box-shadow: 0 0 0 3px var(--smoky-pink-soft); }

  #cart-drawer .smoky-dlv__textarea[hidden],
  .smoky-dlv .smoky-dlv__textarea[hidden] { display: none; }

  .smoky-dlv__error {
    margin: 12px 0 0 4px;
    color: #c8005f;
    font-family: var(--smoky-font-body);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .smoky-dlv__error[hidden] { display: none; }

  /* checkout button while the details are being saved */
  .cart__checkout-button.is-smoky-busy { opacity: 0.65; pointer-events: none; }

  @media (prefers-reduced-motion: reduce) {
    .smoky-dlv__choice.is-empty { animation: none; }
  }
{% endstylesheet %}
