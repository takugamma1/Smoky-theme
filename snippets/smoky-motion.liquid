{%- doc -%}
  Smoky motion engine, rendered once at the end of theme.liquid <body>.

  Loads GSAP + ScrollTrigger (CDN, deferred) and wires the shared behaviours:
  - [data-smoky-reveal]            scroll-in reveal (adds .is-inview, CSS animates)
  - [data-smoky-marquee]           infinite marquee; data-marquee-speed (px/s),
                                   data-marquee-direction="left|right"; reverses with scroll direction
  - [data-smoky-countup]           number counts up on enter (keeps suffix like "+")
  - [data-smoky-scrub-rotate="30"] rotates from -deg to +deg scrubbed across the viewport
  - [data-smoky-loop-words]        cycles child .smoky-loop-word items every 2s
  - [data-smoky-drag-cursor]       pink "Влачи" cursor bubble over draggable sliders

  Everything degrades gracefully: without JS or with reduced motion the content
  is fully visible and static. Re-inits per section on shopify:section:load.
{%- enddoc -%}
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js" defer></script>
<script>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const onReady = (fn) => {
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
      else fn();
    };

    /* Waits for the deferred GSAP scripts without blocking no-JS rendering. */
    const withGsap = (fn) => {
      if (window.gsap && window.ScrollTrigger) return fn(window.gsap);
      let tries = 0;
      const t = setInterval(() => {
        if (window.gsap && window.ScrollTrigger) {
          clearInterval(t);
          window.gsap.registerPlugin(window.ScrollTrigger);
          fn(window.gsap);
        } else if (++tries > 100) clearInterval(t);
      }, 50);
    };

    /* ---- reveals (IntersectionObserver; independent of GSAP) ---- */
    const initReveals = (scope) => {
      const els = scope.querySelectorAll('[data-smoky-reveal]:not(.is-inview)');
      if (!els.length) return;
      if (reduced || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-inview'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const delay = parseFloat(el.dataset.smokyRevealDelay || 0);
              setTimeout(() => el.classList.add('is-inview'), delay * 1000);
              io.unobserve(el);
            }
          });
        },
        { rootMargin: '0px 0px -12% 0px' }
      );
      els.forEach((el) => io.observe(el));
    };

    /* ---- marquees ---- */
    const initMarquees = (scope) => {
      scope.querySelectorAll('[data-smoky-marquee]:not([data-smoky-init])').forEach((marquee) => {
        marquee.dataset.smokyInit = '1';
        const track = marquee.querySelector('.smoky-marquee-track');
        if (!track || !track.children.length) return;

        // clone content until the track safely covers 2x the viewport
        const originals = [...track.children];
        while (track.scrollWidth < (window.innerWidth || 1200) * 2.2) {
          originals.forEach((child) => track.appendChild(child.cloneNode(true)));
          if (track.children.length > 200) break;
        }
        if (reduced) return;

        withGsap((gsap) => {
          const speed = parseFloat(marquee.dataset.marqueeSpeed || 60);
          const dir = marquee.dataset.marqueeDirection === 'right' ? 1 : -1;
          let unit = 0;
          originals.forEach((_, i) => (unit += track.children[i].offsetWidth));
          if (!unit) return;
          const wrap = gsap.utils.wrap(-unit, 0);
          let x = 0;
          let scrollDir = 1;

          window.ScrollTrigger.create({
            onUpdate: (self) => (scrollDir = self.direction || 1),
          });

          gsap.ticker.add((_, delta) => {
            x += dir * scrollDir * speed * (delta / 1000);
            gsap.set(track, { x: wrap(dir === 1 ? x - unit : x) });
          });
        });
      });
    };

    /* ---- count-up stats ---- */
    const initCountups = (scope) => {
      scope.querySelectorAll('[data-smoky-countup]:not([data-smoky-init])').forEach((el) => {
        el.dataset.smokyInit = '1';
        const raw = el.textContent.trim();
        const match = raw.match(/^([\d\s.,]*\d)(.*)$/);
        if (!match) return;
        const target = parseFloat(match[1].replace(/[\s.]/g, '').replace(',', '.'));
        const suffix = match[2] || '';
        if (reduced || isNaN(target)) return;
        el.textContent = '0' + suffix;
        withGsap((gsap) => {
          const counter = { v: 0 };
          gsap.to(counter, {
            v: target,
            duration: 1.6,
            ease: 'expo.out',
            scrollTrigger: { trigger: el, start: 'top 88%' },
            onUpdate: () => {
              el.textContent = Math.round(counter.v).toLocaleString('bg-BG') + suffix;
            },
          });
        });
      });
    };

    /* ---- scrubbed sticker rotation ---- */
    const initScrubs = (scope) => {
      if (reduced) return;
      scope.querySelectorAll('[data-smoky-scrub-rotate]:not([data-smoky-init])').forEach((el) => {
        el.dataset.smokyInit = '1';
        const deg = parseFloat(el.dataset.smokyScrubRotate || 20);
        withGsap((gsap) => {
          gsap.fromTo(
            el,
            { rotation: -deg },
            {
              rotation: deg,
              ease: 'none',
              scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true },
            }
          );
        });
      });
    };

    /* ---- looping word bubble ---- */
    const initLoopWords = (scope) => {
      scope.querySelectorAll('[data-smoky-loop-words]:not([data-smoky-init])').forEach((box) => {
        box.dataset.smokyInit = '1';
        const words = box.querySelectorAll('.smoky-loop-word');
        if (words.length < 2) return;
        let i = 0;
        words.forEach((w, idx) => w.setAttribute('data-word-status', idx === 0 ? 'active' : 'next'));
        if (reduced) return;
        setInterval(() => {
          const prev = words[i];
          i = (i + 1) % words.length;
          const next = words[i];
          prev.setAttribute('data-word-status', 'prev');
          next.setAttribute('data-word-status', 'active');
          setTimeout(() => prev.setAttribute('data-word-status', 'next'), 500);
        }, 2200);
      });
    };

    /* ---- mascot cursor companion: Димо trails the pointer with a springy lerp ---- */
    const initMascotCursor = () => {
      if (reduced) return;
      if (window.matchMedia('(hover: none)').matches || window.matchMedia('(pointer: coarse)').matches) return;
      if (document.querySelector('.smoky-cursor-mascot')) return;
      const el = document.createElement('div');
      el.className = 'smoky-cursor-mascot';
      el.innerHTML =
        '<img class="smoky-cursor-mascot__base" src="{{ 'smoky-mascot-front.svg' | asset_url }}" alt="" width="54" height="54">' +
        '<img class="smoky-cursor-mascot__alt" src="{{ 'smoky-mascot-happy.svg' | asset_url }}" alt="" width="54" height="54">';
      document.body.appendChild(el);
      withGsap((gsap) => {
        const qx = gsap.quickTo(el, 'x', { duration: 0.55, ease: 'power3.out' });
        const qy = gsap.quickTo(el, 'y', { duration: 0.55, ease: 'power3.out' });
        const qr = gsap.quickTo(el, 'rotation', { duration: 0.5, ease: 'power2.out' });
        let shown = false;
        let lastX = 0;
        let hidden = false;
        window.addEventListener('mousemove', (e) => {
          if (!shown) {
            shown = true;
            gsap.set(el, { x: e.clientX + 20, y: e.clientY + 24 });
            gsap.to(el, { scale: 1, duration: 0.5, ease: 'back.out(2.2)' });
          }
          qx(e.clientX + 20);
          qy(e.clientY + 24);
          qr(gsap.utils.clamp(-16, 16, (e.clientX - lastX) * 1.4));
          lastX = e.clientX;

          // duck out of the way while the "Влачи" drag bubble owns the cursor
          const overDrag = !!e.target.closest?.('[data-smoky-drag-cursor]');
          if (overDrag !== hidden) {
            hidden = overDrag;
            gsap.to(el, { scale: hidden ? 0 : 1, duration: 0.35, ease: hidden ? 'power2.in' : 'back.out(2.2)' });
          }

          // Димо lights up over anything clickable
          el.classList.toggle('is-hover', !!e.target.closest?.('a, button'));
        });
        document.documentElement.addEventListener('mouseleave', () => gsap.to(el, { scale: 0, duration: 0.3 }));
        document.documentElement.addEventListener('mouseenter', () => {
          if (!hidden) gsap.to(el, { scale: 1, duration: 0.4, ease: 'back.out(2.2)' });
        });
      });
    };

    /* ---- drag cursor bubble ---- */
    const initDragCursor = () => {
      if (reduced || window.matchMedia('(hover: none)').matches) return;
      if (document.querySelector('.smoky-cursor-bubble')) return;
      const targets = document.querySelectorAll('[data-smoky-drag-cursor]');
      if (!targets.length) return;
      const bubble = document.createElement('div');
      bubble.className = 'smoky-cursor-bubble';
      bubble.textContent = 'Влачи';
      document.body.appendChild(bubble);
      withGsap((gsap) => {
        const setX = gsap.quickTo(bubble, 'x', { duration: 0.5, ease: 'power3.out' });
        const setY = gsap.quickTo(bubble, 'y', { duration: 0.5, ease: 'power3.out' });
        window.addEventListener('mousemove', (e) => {
          setX(e.clientX);
          setY(e.clientY);
        });
        document.querySelectorAll('[data-smoky-drag-cursor]').forEach((t) => {
          t.addEventListener('mouseenter', () => gsap.to(bubble, { scale: 1, duration: 0.4, ease: 'back.out(2)' }));
          t.addEventListener('mouseleave', () => gsap.to(bubble, { scale: 0, duration: 0.3, ease: 'power2.in' }));
        });
      });
    };

    const initAll = (scope) => {
      initReveals(scope);
      initMarquees(scope);
      initCountups(scope);
      initScrubs(scope);
      initLoopWords(scope);
      initDragCursor();
      initMascotCursor();
    };

    onReady(() => initAll(document));
    document.addEventListener('shopify:section:load', (e) => initAll(e.target));
  })();
</script>
